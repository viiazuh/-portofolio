  </div>

  <!-- CERTIFICATE PREVIEW MODAL (Full Interactivity)                     -->
  <div id="cert-modal" class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden justify-center items-center p-4">
    <div class="bg-white rounded-2xl overflow-hidden w-full max-w-4xl h-[85vh] flex flex-col relative shadow-2xl animate-fade-in-up" id="modal-content">
      <!-- Modal Header -->
      <div class="p-4 px-6 border-b border-slate-100 flex justify-between items-center bg-white">
        <div>
          <h3 id="modal-title" class="text-base sm:text-lg font-bold text-slate-900"></h3>
          <p id="modal-issuer" class="text-xs text-slate-500"></p>
        </div>
        <button id="modal-close" class="p-2 bg-slate-100 rounded-full hover:bg-red-50 hover:text-red-600 transition-colors" aria-label="Close modal">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="flex-1 bg-slate-100 overflow-hidden relative flex items-center justify-center p-4">
        <iframe id="modal-iframe" src="" class="w-full h-full rounded-xl shadow-inner bg-white hidden" title="Certificate PDF"></iframe>
        <img id="modal-img" src="" alt="" class="max-w-full max-h-full object-contain rounded-xl shadow-lg hidden" />
      </div>

      <!-- Modal Footer -->
      <div class="p-3 px-6 border-t border-slate-100 bg-white flex justify-end gap-3">
        <a id="modal-download" href="" download class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs hover:bg-slate-800 flex items-center gap-2">
          Unduh File
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    // 1. Parallax subtle float for the 3D model when scrolling down past Hero
    const heroModel = document.getElementById('hero-model-wrap');
    if (heroModel) {
      gsap.to(heroModel, {
        y: 80,
        opacity: 0.7,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }

    // 2. Robust Fail-Safe Reveal System (Never leaves cards invisible)
    const cards = document.querySelectorAll<HTMLElement>(
      '.experience-card, .service-card, .project-card, .cert-card, .gs-section-header, .gs-contact-card'
    );

    // If browser arrives at a hash (e.g. /#services, /#projects), reveal immediately
    const hasHash = window.location.hash.length > 1;

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            target.style.opacity = '1';
            target.style.transform = 'translateY(0)';
            revealObserver.unobserve(target);
          }
        });
      },
      {
        rootMargin: '120px 0px 50px 0px', // trigger early so user never sees blank space
        threshold: 0.05,
      }
    );

    cards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      // If already in or near viewport or page loaded with hash, keep immediately visible!
      if (hasHash || rect.top < window.innerHeight + 150) {
        card.style.opacity = '1';
        card.style.transform = 'none';
      } else {
        card.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
        card.style.opacity = '0';
        card.style.transform = 'translateY(24px)';
        revealObserver.observe(card);
      }
    });

    // Safety fallback: after 600ms, ensure 100% of all cards are unconditionally visible
    setTimeout(() => {
      cards.forEach((card) => {
        card.style.opacity = '1';
        card.style.transform = 'none';
      });
    }, 600);

    // 7. Magnetic effect for tech items
    document.querySelectorAll<HTMLElement>('.tech-item').forEach((item) => {
      item.addEventListener('mousemove', (e) => {
        const rect = item.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const dx = (e.clientX - centerX) / 4;
        const dy = (e.clientY - centerY) / 4;
        item.style.transform = `translate(${dx}px, ${dy}px)`;
      });
      item.addEventListener('mouseleave', () => {
        item.style.transform = 'translate(0, 0)';
      });
    });

    // 8. Certificates Modal Logic
    const modal = document.getElementById('cert-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalIssuer = document.getElementById('modal-issuer');
    const modalIframe = document.getElementById('modal-iframe') as HTMLIFrameElement | null;
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const modalDownload = document.getElementById('modal-download') as HTMLAnchorElement | null;
    const modalClose = document.getElementById('modal-close');

    function openModal(title: string, issuer: string, file: string, isPdf: boolean) {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = title;
      if (modalIssuer) modalIssuer.textContent = `Issued by: ${issuer}`;
      if (modalDownload) modalDownload.href = file;

      if (isPdf && modalIframe && modalImg) {
        modalIframe.src = file;
        modalIframe.classList.remove('hidden');
        modalImg.classList.add('hidden');
      } else if (modalImg && modalIframe) {
        modalImg.src = file;
        modalImg.alt = title;
        modalImg.classList.remove('hidden');
        modalIframe.classList.add('hidden');
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (modalIframe) modalIframe.src = '';
      if (modalImg) modalImg.src = '';
    }

    document.querySelectorAll<HTMLElement>('.cert-card').forEach((card) => {
      card.addEventListener('click', () => {
        openModal(
          card.dataset.title ?? '',
          card.dataset.issuer ?? '',
          card.dataset.file ?? '',
          card.dataset.isPdf === 'true'
        );
      });
    });

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }
  document.addEventListener('astro:page-load', initAnimations);
</script>

