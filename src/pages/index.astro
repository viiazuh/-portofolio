---
// index.astro — Unified Single-Page Portfolio with GSAP ScrollTrigger, Lenis Smooth Scroll
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';

const experiences = [
  {
    role: "IT Support & Data Entry",
    company: "Pustu (Puskesmas Pembantu)",
