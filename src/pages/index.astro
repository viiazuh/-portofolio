---

<Layout title="Vio Azuhri | Cross-Platform Developer">
  <div class="relative overflow-hidden min-h-screen flex flex-col">
    
    <!-- BACKGROUND ATMOSPHERE & MESH DECORATION -->
    <div class="absolute inset-0 z-0 h-full w-full bg-white bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:16px_28px] pointer-events-none"></div>
    <div class="absolute top-12 left-10 w-[500px] h-[500px] bg-blue-400/15 rounded-full blur-[120px] pointer-events-none -z-10"></div>
    <div class="absolute top-[600px] right-10 w-[500px] h-[500px] bg-purple-400/15 rounded-full blur-[130px] pointer-events-none -z-10"></div>
    <div class="absolute top-[1600px] left-10 w-[500px] h-[500px] bg-amber-400/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <section id="hero" class="relative z-10 pt-4 md:pt-10 pb-16 min-h-[calc(100vh-80px)] flex flex-col justify-center">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">

        <!-- LEFT: Greeting & Identity & Quick Actions -->
        <div class="lg:col-span-4 text-center lg:text-left flex flex-col justify-center order-2 lg:order-1 gs-hero-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-slate-900 text-white rounded-full font-bold text-xs mb-5 shadow-lg shadow-slate-900/10 w-fit mx-auto lg:mx-0 hover:scale-105 transition-transform cursor-default">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            OPEN FOR WORK
          </div>

          <p class="text-slate-500 font-semibold text-lg md:text-xl tracking-wide mb-1">
            Hello! I'm
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-none mb-6">
            VIO<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-amber-500">
              AZUHRI
            </span>
          </h1>

          <p class="text-slate-600 text-sm md:text-base leading-relaxed mb-8 max-w-sm mx-auto lg:mx-0">
            Seorang <b>Cross-Platform Developer</b>. Membangun aplikasi web dan mobile
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            <a href="#projects" class="relative inline-flex items-center gap-2 px-7 py-3.5 font-bold text-white transition-all duration-200 bg-slate-900 rounded-full hover:bg-slate-800 text-sm shadow-lg shadow-slate-900/20 hover:shadow-slate-900/40 hover:-translate-y-0.5 group">
              VIEW PROJECTS
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <a href="/VioAzuhri.pdf" download="CV_Azuzu_FullStack.pdf" class="inline-flex items-center gap-2 px-6 py-3.5 font-bold text-slate-800 bg-white border-2 border-slate-200 rounded-full hover:border-blue-600 hover:text-blue-600 transition-all text-sm shadow-sm hover:-translate-y-0.5">
              Download CV
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

          <!-- CENTER: Seamless 3D Avatar -->
   <!-- CENTER: Seamless 3D Avatar (Responsive Height untuk Mobile & Desktop) -->
      <div id="hero-model-wrap" class="lg:col-span-4 relative flex items-center justify-center order-1 lg:order-2 my-0 gs-hero-center w-full">
        <div class="w-full max-w-[280px] sm:max-w-[350px] lg:max-w-[440px] relative">
          
          <!-- Tampilan Mobile (Height 320px) -->
          <div class="block lg:hidden">
            <ModelViewer modelPath="/model.glb" height="320px" />
          </div>

          <!-- Tampilan Laptop/Desktop (Height 540px) -->
          <div class="hidden lg:block">
            <ModelViewer modelPath="/model.glb" height="540px" />
          </div>

        </div>
      </div>
        <!-- RIGHT: Big Typography Role & Metrics (Like Aden Kesuma) -->
        <div class="lg:col-span-4 text-center lg:text-left flex flex-col justify-center order-3 space-y-5 gs-hero-right">
          <div>
            <span class="text-xs uppercase tracking-widest font-extrabold text-indigo-600 block mb-1">
              Cross-Platform
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-none uppercase">
              DEVELOPER
            </h2>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-400 via-slate-600 to-slate-900 tracking-tight leading-none uppercase mt-1">
              INNOVATOR
            </h2>
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-3 pt-5 border-t border-slate-200/80 max-w-sm mx-auto lg:mx-0">
            <div class="p-3.5 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm text-center hover:shadow-md transition-all">
              <div class="text-2xl font-black text-slate-900">19+</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Projects</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm text-center hover:shadow-md transition-all">
              <div class="text-2xl font-black text-slate-900">9+</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Certificates</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm text-center hover:shadow-md transition-all">
              <div class="text-2xl font-black text-slate-900">3y</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Experience</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick Scroll Down Hint -->
      <div class="text-center pt-8 hidden md:block">
        <a href="#experience" class="inline-flex flex-col items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-slate-700 transition-colors">
          <span>EXPLORE JOURNEY</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>
    </section>

<!-- EXPERIENCE SECTION - GSAP TIMELINE UI -->
<section id="experience" class="py-24 px-4 max-w-5xl mx-auto overflow-hidden relative">
  <div class="max-w-5xl mx-auto">
  <div class="text-center mb-16 gs-section-header">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 font-extrabold text-xs uppercase tracking-wider mb-3">
      Journey
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
      Work <span class="text-indigo-600">Experience</span>
    </h2>
  </div>

  <div class="relative ml-4 md:ml-12 lg:ml-24">
    <!-- Timeline Line -->
    <div class="absolute left-0 top-2 bottom-0 w-1 bg-gradient-to-b from-indigo-500 via-purple-400 to-transparent rounded-full opacity-30 origin-top gs-timeline-line"></div>

    <div class="space-y-10 pl-8 md:pl-12">
      {experiences.map((item, index) => (
        <div class="experience-card relative group">
          <!-- Animated Circle Indicator -->
          <div class="absolute -left-[42px] md:-left-[58px] top-1.5 w-6 h-6 rounded-full bg-white border-4 border-indigo-500 shadow-md group-hover:scale-125 group-hover:border-purple-500 transition-all duration-300 z-10"></div>
          
          <!-- Ping Effect on Hover -->
          <div class="absolute -left-[42px] md:-left-[58px] top-1.5 w-6 h-6 rounded-full bg-indigo-400 opacity-0 group-hover:animate-ping z-0"></div>

          <!-- Card Container -->
          <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-100 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
            <!-- Subtle Background Gradient -->
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row md:justify-between md:items-start gap-3 mb-3">
              <div>
                <h3 class="text-xl font-black text-slate-900 group-hover:text-indigo-600 transition-colors">{item.role}</h3>
                <p class="text-sm font-bold text-indigo-500 mt-1 uppercase tracking-wider">
                  {item.company}
                </p>
              </div>
              <span class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 text-xs font-bold tracking-widest uppercase whitespace-nowrap">
                {item.period}
              </span>
            </div>
            
            <p class="relative z-10 text-slate-600 text-sm md:text-base leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
    </div>
  </div>
</section>
    <!-- 3. SERVICES SECTION (Sticky / Parallax ScrollTrigger Cards)        -->

    <section id="services" class="py-24 relative">
      <div class="text-center max-w-2xl mx-auto mb-16 gs-section-header">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 font-extrabold text-xs uppercase tracking-wider mb-3">
          Specializations
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
          Services &amp; <span class="text-blue-600">Expertise</span>
        </h2>
        <p class="text-slate-500 text-base mt-3">Layanan profesional yang saya tawarkan dengan fokus pada kecepatan, keamanan, dan skalabilitas.</p>
      </div>

      <!-- Sticky / Staggered Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto gs-services-cards">
        {skills.map((skill, idx) => (
          <div class={`service-card relative p-8 rounded-3xl bg-white border border-slate-200/90 shadow-xl shadow-slate-100/80 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 overflow-hidden group`}>
            <!-- Subtle Top Accent Gradient -->
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-blue-500 via-indigo-500 to-amber-500 opacity-80"></div>
            
            <div class="flex items-center justify-between mb-6">
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 text-slate-800 group-hover:scale-110 group-hover:bg-slate-900 group-hover:text-white transition-all shadow-sm" set:html={skill.icon} />
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-slate-100 text-slate-700">
                {skill.badge}
              </span>
            </div>

            <h3 class="text-2xl font-extrabold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">
              {skill.title}
            </h3>

            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              {skill.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100">
              {skill.techs.map((tech) => (
                <span class="px-3 py-1 bg-slate-50 border border-slate-100 text-slate-700 rounded-lg text-xs font-semibold">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
    <!-- 4. FEATURED PROJECTS SECTION (Horizontal GSAP Scroll)             -->
    <section id="projects" class="relative border-t border-slate-100">
      <!-- This is the pin container — it will be pinned to viewport -->
      <div class="gs-projects-pin-section h-screen flex flex-col overflow-hidden">
        <!-- Header (stays visible during horizontal scroll) -->
        <div class="pt-12 pb-6 flex-shrink-0">
          <div class="text-center max-w-2xl mx-auto gs-section-header px-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 font-extrabold text-xs uppercase tracking-wider mb-3">
              Selected Works
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
              Featured <span class="text-amber-500">Projects</span>
            </h2>
            <p class="text-slate-500 text-base mt-3">Koleksi proyek nyata yang saya rancang dan kembangkan.</p>
          </div>

          <!-- Scroll hint -->
          <div class="flex items-center justify-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest mt-4">
            <span>Scroll to explore</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-pulse"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </div>

        <!-- Horizontal track area — fills remaining height -->
        <div class="flex-1 flex items-center overflow-hidden">
          <div class="gs-projects-track flex gap-8 pl-6 md:pl-12 lg:pl-24 pr-[50vw] will-change-transform">
            {projects.map((p, idx) => (
              <div class={`project-card flex-shrink-0 w-[85vw] sm:w-[70vw] md:w-[420px] lg:w-[400px] h-fit flex flex-col justify-between p-7 rounded-3xl bg-white border border-slate-200/90 shadow-lg shadow-slate-100 hover:shadow-2xl hover:border-amber-400/80 transition-all duration-300 group hover:-translate-y-2`}>
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200/60">
                      {p.category}
                    </span>
                    <span class="text-xs font-semibold text-emerald-600 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      {p.highlight}
                    </span>
                  </div>

                  <!-- Project number indicator -->
                  <div class="text-[80px] font-black text-slate-100 leading-none -mb-6 pointer-events-none select-none">
                    {String(idx + 1).padStart(2, '0')}
                  </div>

                  <h3 class="text-xl font-black text-slate-900 mb-3 group-hover:text-amber-600 transition-colors relative z-10">
                    {p.title}
                  </h3>

                  <p class="text-slate-600 text-sm leading-relaxed mb-6 line-clamp-3">
                    {p.description}
                  </p>
                </div>

                <div>
                  <div class="flex flex-wrap gap-1.5 mb-6">
                    {p.stack.map((t) => (
                      <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md text-xs font-medium">
                        {t}
                      </span>
                    ))}
                  </div>

                  <a
                    href={p.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-slate-50 hover:bg-slate-900 text-slate-700 hover:text-white font-bold text-xs transition-all duration-200"
                  >
                    <span>Lihat Repository</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Progress bar (bottom of pinned area) -->
        <div class="flex-shrink-0 px-6 md:px-12 lg:px-24 pb-6">
          <div class="h-1 bg-slate-100 rounded-full overflow-hidden max-w-4xl mx-auto">
            <div class="gs-projects-progress h-full bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500 rounded-full" style="width: 0%"></div>
          </div>
          <div class="flex justify-between max-w-4xl mx-auto mt-2">
            <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">01</span>
            <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest gs-projects-counter">01 / {String(projects.length).padStart(2, '0')}</span>
            <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">{String(projects.length).padStart(2, '0')}</span>
          </div>
        </div>
      </div>
    </section>
    <!-- 5. CERTIFICATES SECTION (Horizontal Velocity Scroll)-->
    <section id="certificates" class="py-24 relative border-t border-slate-100">
      <div class="text-center max-w-2xl mx-auto mb-16 gs-section-header">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-900/40 text-emerald-400 font-extrabold text-xs uppercase tracking-wider mb-3 border border-emerald-500/20">
          Credentials
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
          Verified <span class="text-emerald-400">Certificates</span>
        </h2>
        <p class="text-slate-400 text-base mt-3">Bukti kompetensi profesional dari Huawei, Dicoding, dan SkillPedia.</p>
      </div>

      <!-- Certificates Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto gs-certs-grid px-4">
        {certs.map((cert) => (
          <div
            class="cert-card group relative cursor-pointer rounded-2xl overflow-hidden shadow-md hover:shadow-2xl hover:shadow-emerald-500/20 border border-slate-700 aspect-[4/3] bg-slate-800 transition-all duration-300 hover:-translate-y-1.5"
            data-title={cert.title}
            data-issuer={cert.issuer}
            data-file={cert.file}
            data-is-pdf={cert.isPdf ? 'true' : 'false'}
          >
            {cert.isPdf ? (
              <div class="w-full h-full flex flex-col items-center justify-center bg-slate-800 text-slate-400 group-hover:scale-105 transition-transform duration-500 p-6 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500 mb-2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">{cert.title}</span>
                <span class="text-[10px] text-slate-500 mt-1">PDF DOCUMENT</span>
              </div>
            ) : (
              <img
                src={cert.file}
                alt={cert.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100"
              />
            )}

            <!-- Hover Overlay -->
            <div class="absolute inset-0 bg-slate-900/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center text-white p-6 text-center backdrop-blur-sm">
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-400 mb-1">{cert.tag}</span>
              <h3 class="font-extrabold text-base leading-tight mb-1">{cert.title}</h3>
              <p class="text-xs text-slate-300 mb-4">{cert.issuer}</p>
              <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-500 text-slate-950 rounded-full text-xs font-bold shadow-md hover:bg-emerald-400 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                Preview Detail
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>
    <!-- 6. CONTACT SECTION (High-Impact Direct Email & Outreach)          -->
    <section id="contact" class="py-24 relative border-t border-slate-100">
      <div class="max-w-4xl mx-auto rounded-3xl p-8 sm:p-12 md:p-16 bg-slate-900 text-white text-center relative overflow-hidden shadow-2xl gs-contact-card">
        <!-- Ambient internal glow -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-amber-400 font-bold text-xs uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            Let's Collaborate
          </div>

          <h2 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight mb-6">
            Ready to Build Your Next <br class="hidden sm:block"/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-300 to-amber-400">
              Web or Mobile Solution?
            </span>
          </h2>

          <p class="text-slate-300 text-base md:text-lg max-w-xl mx-auto leading-relaxed mb-10">
            Saya terbuka untuk proyek baru, kerja sama full-time, ataupun konsultasi teknis. Mari diskusikan ide dan kebutuhan Anda sekarang!
          </p>

          <div class="flex flex-wrap gap-4 justify-center items-center">
            <a
              href="mailto:sequadtaswan@gmail.com"
              class="inline-flex items-center gap-2.5 px-8 py-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black rounded-full shadow-xl shadow-amber-500/30 transition-all duration-300 hover:scale-105"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              EMAIL SAYA SEKARANG
            </a>

            <a
              href="https://www.linkedin.com/in/vio-azuhri-b5a25530a"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-full border border-white/15 transition-all hover:scale-105"
            >
              LinkedIn Profile
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- CERTIFICATE PREVIEW MODAL (Full Interactivity)                     -->
  <div id="cert-modal" class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden justify-center items-center p-4">
    <div class="bg-white rounded-2xl overflow-hidden w-full max-w-4xl h-[85vh] flex flex-col relative shadow-2xl animate-fade-in-up" id="modal-content">
      <!-- Modal Header -->
      <div class="p-4 px-6 border-b border-slate-100 flex justify-between items-center bg-white">
        <div>
          <h3 id="modal-title" class="text-base sm:text-lg font-bold text-slate-900"></h3>
          <p id="modal-issuer" class="text-xs text-slate-500"></p>
        </div>
        <button id="modal-close" class="p-2 bg-slate-100 rounded-full hover:bg-red-50 hover:text-red-600 transition-colors" aria-label="Close modal">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="flex-1 bg-slate-100 overflow-hidden relative flex items-center justify-center p-4">
        <iframe id="modal-iframe" src="" class="w-full h-full rounded-xl shadow-inner bg-white hidden" title="Certificate PDF"></iframe>
        <img id="modal-img" src="" alt="" class="max-w-full max-h-full object-contain rounded-xl shadow-lg hidden" />
      </div>

      <!-- Modal Footer -->
      <div class="p-3 px-6 border-t border-slate-100 bg-white flex justify-end gap-3">
        <a id="modal-download" href="" download class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl text-xs hover:bg-slate-800 flex items-center gap-2">
          Unduh File
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    // 1. Parallax subtle float for the 3D model when scrolling down past Hero
    const heroModel = document.getElementById('hero-model-wrap');
    if (heroModel) {
      gsap.to(heroModel, {
        y: 80,
        opacity: 0.7,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }

    let mm = gsap.matchMedia();

    // 1.5 Experience Section Timeline Line
    const expLine = document.querySelector('.gs-timeline-line');
    if (expLine) {
      gsap.fromTo(expLine, 
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '#experience',
            start: 'top 60%',
            end: 'bottom 80%',
            scrub: true,
          }
        }
      );
    }

    mm.add({
      isMobile: "(max-width: 767px)",
      isDesktop: "(min-width: 768px)"
    }, (context) => {
      let { isMobile } = context.conditions;

      // Experience Cards
      const expCards = gsap.utils.toArray('.experience-card');
      if (expCards.length) {
        expCards.forEach((card: any) => {
          gsap.fromTo(card, 
            { opacity: 0, x: isMobile ? 20 : 50, y: 20 },
            {
              opacity: 1, x: 0, y: 0, duration: 0.8, ease: 'power3.out',
              scrollTrigger: { trigger: card, start: 'top 90%', toggleActions: 'play reverse play reverse' }
            }
          );
        });
      }

      // Section Headers
      gsap.utils.toArray('.gs-section-header').forEach((header: any) => {
        gsap.fromTo(header,
          { opacity: 0, y: isMobile ? 20 : 30 },
          {
            opacity: 1, y: 0, duration: 1, ease: 'power3.out',
            scrollTrigger: { trigger: header, start: 'top 90%', toggleActions: 'play reverse play reverse' }
          }
        );
      });

      // Services Cards
      const serviceCards = gsap.utils.toArray('.service-card');
      if (serviceCards.length) {
        gsap.fromTo(serviceCards,
          { opacity: 0, y: isMobile ? 25 : 40 },
          {
            opacity: 1, y: 0, duration: 0.8, stagger: isMobile ? 0.1 : 0.2, ease: 'back.out(1.7)',
            scrollTrigger: { trigger: '.gs-services-cards', start: 'top 85%', toggleActions: 'play reverse play reverse' }
          }
        );
      }

      // Projects — Horizontal Scroll (pinned on both desktop & mobile)
      const pinSection = document.querySelector('.gs-projects-pin-section') as HTMLElement;
      const projectTrack = document.querySelector('.gs-projects-track') as HTMLElement;
      const projectProgress = document.querySelector('.gs-projects-progress') as HTMLElement;
      const projectCounter = document.querySelector('.gs-projects-counter') as HTMLElement;
      const projectCards = gsap.utils.toArray('.project-card');
      const totalProjects = projectCards.length;

      if (pinSection && projectTrack && projectCards.length) {
        // Calculate how far we need to scroll horizontally
        const getScrollAmount = () => {
          return projectTrack.scrollWidth - window.innerWidth;
        };

        // Pin the section and translate the track horizontally
        const hScrollTween = gsap.to(projectTrack, {
          x: () => -getScrollAmount(),
          ease: 'none',
          scrollTrigger: {
            trigger: pinSection,
            start: 'top top',
            end: () => `+=${getScrollAmount()}`,
            scrub: 1,
            pin: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              // Update progress bar
              if (projectProgress) {
                gsap.set(projectProgress, { width: `${self.progress * 100}%` });
              }
              // Update counter
              if (projectCounter) {
                const currentIdx = Math.min(
                  Math.floor(self.progress * totalProjects) + 1,
                  totalProjects
                );
                projectCounter.textContent = `${String(currentIdx).padStart(2, '0')} / ${String(totalProjects).padStart(2, '0')}`;
              }
            }
          }
        });

        // 3D entrance for each card as it scrolls into the viewport
        projectCards.forEach((card: any) => {
          gsap.fromTo(card,
            { opacity: 0, scale: 0.85, rotateY: 15, y: 40 },
            {
              opacity: 1, scale: 1, rotateY: 0, y: 0,
              duration: 1, ease: 'power3.out',
              scrollTrigger: {
                trigger: card,
                containerAnimation: hScrollTween,
                start: 'left 85%',
                end: 'left 50%',
                toggleActions: 'play none none reverse'
              }
            }
          );
        });
      }

      // Certificates Cards
      const certCards = gsap.utils.toArray('.cert-card');
      if (certCards.length) {
        gsap.fromTo(certCards,
          { opacity: 0, rotationX: isMobile ? 20 : 45, y: isMobile ? 30 : 50, transformPerspective: 1000 },
          {
            opacity: 1, rotationX: 0, y: 0, duration: 1, stagger: 0.1, ease: 'expo.out',
            scrollTrigger: { trigger: '.gs-certs-grid', start: 'top 90%', toggleActions: 'play reverse play reverse' }
          }
        );
      }

      // Contact Card
      const contactCard = document.querySelector('.gs-contact-card');
      if (contactCard) {
        gsap.fromTo(contactCard,
          { opacity: 0, scale: isMobile ? 0.95 : 0.85, y: isMobile ? 30 : 50 },
          {
            opacity: 1, scale: 1, y: 0, duration: 1.2, ease: 'elastic.out(1, 0.7)',
            scrollTrigger: { trigger: contactCard, start: 'top 90%', toggleActions: 'play reverse play reverse' }
          }
        );
      }
    });

    // Hero Elements Entrance (Independent of scroll)
    gsap.fromTo('.gs-hero-left', { opacity: 0, x: -30 }, { opacity: 1, x: 0, duration: 1, ease: 'power3.out', delay: 0.2 });
    gsap.fromTo('.gs-hero-center', { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 1.2, ease: 'back.out(1.5)', delay: 0.4 });
    gsap.fromTo('.gs-hero-right', { opacity: 0, x: 30 }, { opacity: 1, x: 0, duration: 1, ease: 'power3.out', delay: 0.6 });
    const modal = document.getElementById('cert-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalIssuer = document.getElementById('modal-issuer');
    const modalIframe = document.getElementById('modal-iframe') as HTMLIFrameElement | null;
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const modalDownload = document.getElementById('modal-download') as HTMLAnchorElement | null;
    const modalClose = document.getElementById('modal-close');

    function openModal(title: string, issuer: string, file: string, isPdf: boolean) {
      if (!modal) return;
      if (modalTitle) modalTitle.textContent = title;
      if (modalIssuer) modalIssuer.textContent = `Issued by: ${issuer}`;
      if (modalDownload) modalDownload.href = file;

      if (isPdf && modalIframe && modalImg) {
        modalIframe.src = file;
        modalIframe.classList.remove('hidden');
        modalImg.classList.add('hidden');
      } else if (modalImg && modalIframe) {
        modalImg.src = file;
        modalImg.alt = title;
        modalImg.classList.remove('hidden');
        modalIframe.classList.add('hidden');
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (modalIframe) modalIframe.src = '';
      if (modalImg) modalImg.src = '';
    }

    document.querySelectorAll<HTMLElement>('.cert-card').forEach((card) => {
      card.addEventListener('click', () => {
        openModal(
          card.dataset.title ?? '',
          card.dataset.issuer ?? '',
          card.dataset.file ?? '',
          card.dataset.isPdf === 'true'
        );
      });
    });

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.addEventListener('loaderComplete', initAnimations, { once: true });
      setTimeout(initAnimations, 3000); // Fallback
    });
  } else {
    window.addEventListener('loaderComplete', initAnimations, { once: true });
    setTimeout(initAnimations, 3000); // Fallback
  }
  
  // Untuk transisi page di Astro (View Transitions)
  document.addEventListener('astro:page-load', () => {
    initAnimations();
    ScrollTrigger.refresh();
  });
</script>

