// Certificates Data
const certs = [
  { id: 1, title: "Data Science Python", issuer: "SkillPedia", file: "/sertifikat-data-science-python.png", isPdf: false, tag: "Data Science" },
  { id: 2, title: "HTML & CSS", issuer: "SkillPedia", file: "/sertifikat-html-css.png", isPdf: false, tag: "Web Dev" },
  { id: 3, title: "Unity Game Platform", issuer: "SkillPedia", file: "/sertifikat-unity-platform.png", isPdf: false, tag: "Game Dev" },
  { id: 4, title: "Aplikasi Android Intermediate", issuer: "Dicoding", file: "/Android-Intermediate.png", isPdf: false, tag: "Android" },
  { id: 5, title: "Belajar Dasar AI", issuer: "Dicoding", file: "/Belajar-Dasar.Ai.png", isPdf: false, tag: "Artificial Intelligence" },
  { id: 6, title: "Fundamental Aplikasi Android", issuer: "Dicoding", file: "/Fundamental-Aplikasi-Android.png", isPdf: false, tag: "Android" },
