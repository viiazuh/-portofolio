];

// Services / Tech Stack Data
const skills = [
  {
    title: "Full-Stack Development",
    description: "Membangun aplikasi web end-to-end mulai dari antarmuka interaktif hingga optimasi database.",
    techs: ["React", "Vue.js", "Flask", "Node.js", "MySQL", "SQLite 3", "Firebase", "dll"],
    badge: "Frontend & Backend",
    color: "from-blue-500/10 to-indigo-500/10 border-blue-200/80 text-blue-600",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>`,
  },
  {
    title: "Mobile Development",
    description: "Pengembangan aplikasi native dan cross-platform.",
    techs: ["Flutter", "Kotlin", "Dart", "Android Native"],
    badge: "iOS & Android",
    color: "from-purple-500/10 to-pink-500/10 border-purple-200/80 text-purple-600",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>`,
  },
  {
    title: "Deployment & CI/CD",
    description: "Otomatisasi pengiriman kode, containerisasi aman dengan Docker, hingga hosting model Machine Learning.",
    techs: ["Docker", "GitHub Actions", "GitLab CI/CD", "Linux Server Mgmt", "MLOps Basics"],
    badge: "Cloud & DevOps",
    color: "from-emerald-500/10 to-teal-500/10 border-emerald-200/80 text-emerald-600",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
  },
  {
    title: "Tools & Collaboration",
    description: "",
    techs: ["Git", "Postman", "Cloudinary", "Figma", "Vite", "Firebase","supabase", "vercel","streamlit cloud","infinity free"],
    badge: "Productivity",
    color: "from-amber-500/10 to-orange-500/10 border-amber-200/80 text-amber-600",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`,
  },
];

// Featured Projects Data
const projects = [
  {
    title: "Sistem Informasi Dusun",
    description: "Digitalisasi pengumuman warga & dokumentasi desa berbasis cloud dengan Dashboard Admin real-time yang aman dan intuitif.",
    stack: ["React", "Firebase", "Cloudinary", "Dashboard"],
    link: "https://github.com/viiazuh/Web-Kadus-VII-Sei-Rotan",
    category: "Full-Stack Web",
    highlight: "Real-time sync",
  },
  {
    title: "ML Prediction Deployment",
    description: "Platform monitoring deteksi diabetes berbasis Machine Learning yang dideploy menggunakan Flask API dan Docker container.",
    stack: ["Flask", "Docker", "CI/CD", "React"],
    link: "https://github.com/viiazuh/diabetes-app_UTsDevops",
    category: "ML & DevOps",
    highlight: "Dockerized",
  },
  {
    title: "Mobile E-Wallet",
    description: "Aplikasi dompet digital dengan antarmuka modern, interaksi transaksi mulus, dan state management Flutter yang optimal.",
    stack: ["Flutter", "Dart", "State Management"],
    link: "https://github.com/viiazuh/infoin_ewallet",
    category: "Mobile App",
    highlight: "Smooth UX",
  },
  {
    title: "25 Kisah Nabi Android",
    description: "Aplikasi Android native yang dirancang untuk edukasi interaktif dengan performa ringan dan offline caching data.",
    stack: ["Kotlin", "Android Native", "Jetpack"],
    link: "https://github.com/viiazuh/25-prophets",
    category: "Android Native",
    highlight: "Offline Ready",
  },
  {
    title: "PASA: Password Security",
    description: "Proyek kolaboratif Machine Learning untuk mendeteksi kerentanan kata sandi dan analisis keamanan otomatis.",
    stack: ["React", "Python", "ML Security"],
    link: "https://github.com/kentangbiru/PASA",
    category: "AI / Cyber Security",
    highlight: "Team Project",
  },
  {
    title: "Scan Penyakit Padi",
    description: "Proyek kolaboratif Machine Learning untuk mendeteksi Penyakit padi menggunakan stramlit.",
    stack: ["Streamlit", "Python", "ML"],
    link: "https://github.com/viiazuh/scanpadi",
    category: "AI",
    highlight: "Team Project",
  },
  {
    title: "Analisis Sentimen",
    description: "Proyek Tugas akhir Skripsi Analisis sentimen ulasan clash of champion menggunakan metode LSTM & GRU",
    stack: ["Python", "LSTM", "GRU"],
    link: "https://github.com/viiazuh/analisis-sentimen-mobile-legend",
    category: "AI",
    highlight: "Skripsi",
  },
];

// Certificates Data
const certs = [
  { id: 1, title: "Data Science Python", issuer: "SkillPedia", file: "/sertifikat-data-science-python.png", isPdf: false, tag: "Data Science" },
  { id: 2, title: "HTML & CSS", issuer: "SkillPedia", file: "/sertifikat-html-css.png", isPdf: false, tag: "Web Dev" },
  { id: 3, title: "Unity Game Platform", issuer: "SkillPedia", file: "/sertifikat-unity-platform.png", isPdf: false, tag: "Game Dev" },
  { id: 4, title: "Aplikasi Android Intermediate", issuer: "Dicoding", file: "/Android-Intermediate.png", isPdf: false, tag: "Android" },
  { id: 5, title: "Belajar Dasar AI", issuer: "Dicoding", file: "/Belajar-Dasar.Ai.png", isPdf: false, tag: "Artificial Intelligence" },
  { id: 6, title: "Fundamental Aplikasi Android", issuer: "Dicoding", file: "/Fundamental-Aplikasi-Android.png", isPdf: false, tag: "Android" },
  { id: 7, title: "Machine Learning Android", issuer: "Dicoding", file: "/ml-android.png", isPdf: false, tag: "ML & Android" },
  { id: 8, title: "RedHat Linux Certified", issuer: "Huawei", file: "/redhat.png", isPdf: false, tag: "Linux / DevOps" },
  { id: 9, title: "Kampus Merdeka Certified", issuer: "Huawei", file: "/sertifikat kampus merdeka.pdf", isPdf: true, tag: "Program Merdeka" },
];
---

<Layout title="Vio Azuhri | Cross-Platform Developer">
  <!-- PERBAIKAN: ubah overflow-hidden menjadi overflow-x-hidden agar scroll vertikal tidak tertahan -->
  <div class="relative overflow-x-hidden min-h-screen flex flex-col">
    
    <!-- BACKGROUND ATMOSPHERE & COSMIC STAR PARTICLES (HANDLED BY THREE.JS SPACEBACKGROUND) -->
    <div class="absolute inset-0 z-0 h-full w-full bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:16px_28px] pointer-events-none opacity-40"></div>

    <section id="hero" class="relative z-10 pt-4 md:pt-10 pb-16 min-h-[calc(100vh-80px)] flex flex-col justify-center">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">

        <!-- LEFT: Greeting & Identity & Quick Actions -->
        <div class="lg:col-span-4 text-center lg:text-left flex flex-col justify-center order-2 lg:order-1 gs-hero-left">
          <div class="cosmic-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full font-bold text-xs mb-5 w-fit mx-auto lg:mx-0 hover:scale-105 transition-transform cursor-default">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping shadow-[0_0_8px_#38bdf8]"></span>
            OPEN FOR WORK IN COSMOS
          </div>

          <p class="text-purple-300 font-semibold text-lg md:text-xl tracking-wide mb-1">
            Hello! I'm
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-none mb-6">
            VIO<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-amber-300 cosmic-glow-text">
              AZUHRI
            </span>
          </h1>

          <p class="text-slate-300 text-sm md:text-base leading-relaxed mb-8 max-w-md mx-auto lg:mx-0">
            Seorang <b>Cross-Platform Developer</b>. Membangun aplikasi web dan mobile berkinerja tinggi, modern, dan skalabel layaknya misi luar angkasa.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            <a href="#projects" class="cosmic-btn-primary relative inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-full text-sm group">
              VIEW PROJECTS
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <a href="/VioAzuhri.pdf" download="CV_Azuzu_FullStack.pdf" class="cosmic-btn-secondary inline-flex items-center gap-2 px-6 py-3.5 font-bold rounded-full transition-all text-sm">
              Download CV
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

        <!-- CENTER: Seamless 3D Astronaut Monkey & Solar System (Responsive Height) -->
        <div id="hero-model-wrap" class="lg:col-span-4 relative flex items-center justify-center order-1 lg:order-2 my-0 gs-hero-center w-full">
          <div class="w-full max-w-[320px] sm:max-w-[400px] lg:max-w-[500px] relative">
            <div class="block lg:hidden">
              <ModelViewer height="350px" />
            </div>
            <div class="hidden lg:block">
              <ModelViewer height="560px" />
            </div>
          </div>
        </div>

        <!-- RIGHT: Big Typography Role & Metrics (Tetap di Kanan) -->
        <div class="lg:col-span-4 text-center lg:text-left flex flex-col justify-center order-3 space-y-5 gs-hero-right">
          <div>
            <span class="text-xs uppercase tracking-widest font-extrabold text-cyan-400 block mb-1">
              Cross-Platform
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-none uppercase">
              DEVELOPER
            </h2>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-cyan-400 to-indigo-300 tracking-tight leading-none uppercase mt-1">
              INNOVATOR
            </h2>
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-3 pt-5 border-t border-purple-500/20 max-w-md mx-auto lg:mx-0">
            <div class="p-4 rounded-2xl cosmic-card text-center">
              <div class="text-2xl font-black text-cyan-300" data-count="19">19+</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Projects</div>
            </div>
            <div class="p-4 rounded-2xl cosmic-card text-center">
              <div class="text-2xl font-black text-cyan-300" data-count="9">9+</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Certificates</div>
            </div>
            <div class="p-4 rounded-2xl cosmic-card text-center">
              <div class="text-2xl font-black text-cyan-300">3y</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Experience</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick Scroll Down Hint -->
      <div class="text-center pt-8 hidden md:block">
        <a href="#experience" class="inline-flex flex-col items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-cyan-300 transition-colors">
          <span>EXPLORE COSMIC JOURNEY</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>
    </section>

    <!-- EXPERIENCE SECTION - GSAP TIMELINE UI -->
    <section id="experience" class="py-24 px-4 max-w-5xl mx-auto relative">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16 gs-section-header">
          <div class="cosmic-badge inline-flex items-center gap-2 px-3.5 py-1 rounded-full font-extrabold text-xs uppercase tracking-wider mb-3">
            Mission Log
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight">
            Work <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400">Experience</span>
          </h2>
        </div>

        <div class="relative ml-4 md:ml-12 lg:ml-24">
          <!-- Timeline Line -->
          <div class="absolute left-0 top-2 bottom-0 w-1 bg-gradient-to-b from-cyan-400 via-purple-500 to-transparent rounded-full opacity-60 origin-top gs-timeline-line shadow-[0_0_12px_#38bdf8]"></div>

          <div class="space-y-10 pl-8 md:pl-12">
            {experiences.map((item, index) => (
              <div class="experience-card relative group">
                <div class="absolute -left-[42px] md:-left-[58px] top-1.5 w-6 h-6 rounded-full bg-[#070714] border-4 border-cyan-400 shadow-[0_0_12px_#38bdf8] group-hover:scale-125 group-hover:border-purple-400 transition-all duration-300 z-10"></div>
                <div class="absolute -left-[42px] md:-left-[58px] top-1.5 w-6 h-6 rounded-full bg-cyan-400 opacity-0 group-hover:animate-ping z-0"></div>

                <div class="cosmic-card p-6 md:p-8 rounded-3xl relative overflow-hidden transition-all duration-300">
                  <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                  
                  <div class="relative z-10 flex flex-col md:flex-row md:justify-between md:items-start gap-3 mb-3">
                    <div>
                      <h3 class="text-xl font-black text-white group-hover:text-cyan-300 transition-colors">{item.role}</h3>
                      <p class="text-sm font-bold text-purple-400 mt-1 uppercase tracking-wider">
                        {item.company}
                      </p>
                    </div>
                    <span class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-purple-950/60 border border-purple-500/30 text-cyan-300 text-xs font-bold tracking-widest uppercase whitespace-nowrap">
                      {item.period}
                    </span>
                  </div>
                  
                  <p class="relative z-10 text-slate-300 text-sm md:text-base leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE ONLY: PORTFOLIO SHOWCASE WITH SEGMENTED TABS -->
    <section id="portfolio-showcase" class="block md:hidden py-12 px-3 relative border-t border-purple-500/20">
      
      <!-- Header Section -->
      <div class="text-center max-w-sm mx-auto mb-6 relative z-10 px-2 gs-section-header">
        <div class="cosmic-badge inline-flex items-center gap-2 px-3.5 py-1 rounded-full font-extrabold text-xs uppercase tracking-wider mb-2.5">
          Showcase
        </div>
        <h2 class="text-3xl font-black text-white tracking-tight mb-2">
          Portfolio <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-400">Showcase</span>
        </h2>
        <p class="text-slate-400 text-xs leading-relaxed">
          Koleksi proyek nyata, sertifikat terverifikasi, dan keahlian teknis saya dalam satu tempat.
        </p>
      </div>

      <!-- 3 Segmented Buttons Container (Projects, Certificates, Tech Stack) -->
      <div class="relative z-10 max-w-md mx-auto mb-6 p-1.5 bg-[#0f0c2a]/80 border border-purple-500/30 rounded-2xl shadow-inner grid grid-cols-3 gap-1.5 backdrop-blur-md">
        
        <!-- Tab 1: Projects -->
        <button
          type="button"
          data-tab-target="tab-projects"
          class="mobile-showcase-tab flex flex-col items-center justify-center py-2.5 px-1.5 rounded-xl transition-all duration-200 text-slate-400 hover:text-white hover:bg-purple-600/20"
        >
          <div class="mb-1 text-slate-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <span class="text-[11px] font-bold tracking-tight">Projects</span>
        </button>

        <!-- Tab 2: Certificates (Active Default) -->
        <button
          type="button"
          data-tab-target="tab-certificates"
          class="mobile-showcase-tab active-tab flex flex-col items-center justify-center py-2.5 px-1.5 rounded-xl transition-all duration-200 text-white bg-purple-600/40 border border-purple-400/50 shadow-[0_0_15px_rgba(168,85,247,0.4)]"
        >
          <div class="mb-1 text-cyan-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="6"></circle>
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
            </svg>
          </div>
          <span class="text-[11px] font-bold tracking-tight">Certificates</span>
        </button>

        <!-- Tab 3: Tech Stack -->
        <button
          type="button"
          data-tab-target="tab-tech"
          class="mobile-showcase-tab flex flex-col items-center justify-center py-2.5 px-1.5 rounded-xl transition-all duration-200 text-slate-400 hover:text-white hover:bg-purple-600/20"
        >
          <div class="mb-1 text-slate-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="text-[11px] font-bold tracking-tight">Tech Stack</span>
        </button>
      </div>

      <!-- Tab Content Panels -->
      <div class="relative z-10 max-w-md mx-auto">
        <!-- 1. PROJECTS PANEL -->
        <div id="tab-projects" class="mobile-tab-panel hidden space-y-4">
          {projects.map((p, idx) => (
            <div class="p-5 rounded-2xl cosmic-card">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-md bg-purple-950/60 text-purple-300 border border-purple-500/30">
                  {p.category}
                </span>
                <span class="text-[11px] font-semibold text-cyan-400 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_6px_#38bdf8]"></span>
                  {p.highlight}
                </span>
              </div>
              <h3 class="text-base font-black text-white mb-1.5">{p.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-3">{p.description}</p>
              <div class="flex flex-wrap gap-1.5 mb-3.5">
                {p.stack.map((t) => (
                  <span class="px-2 py-0.5 bg-purple-950/50 border border-purple-500/20 text-purple-300 rounded-md text-[10px] font-medium">
                    {t}
                  </span>
                ))}
              </div>
              <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                class="cosmic-btn-primary inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl font-bold text-xs"
              >
                <span>Lihat Repository</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </a>
            </div>
          ))}
        </div>

        <!-- 2. CERTIFICATES PANEL -->
        <div id="tab-certificates" class="mobile-tab-panel space-y-4">
          {certs.map((cert) => (
            <div
              class="cert-card cursor-pointer rounded-2xl overflow-hidden cosmic-card group transition-transform active:scale-[0.98]"
              data-title={cert.title}
              data-issuer={cert.issuer}
              data-file={cert.file}
              data-is-pdf={cert.isPdf ? 'true' : 'false'}
            >
              {cert.isPdf ? (
