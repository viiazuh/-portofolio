// Featured Projects Data
const projects = [
  {
    title: "Sistem Informasi Dusun",
    description: "Digitalisasi pengumuman warga & dokumentasi desa berbasis cloud dengan Dashboard Admin real-time yang aman dan intuitif.",
    stack: ["React", "Firebase", "Cloudinary", "Dashboard"],
    link: "https://github.com/viiazuh/Web-Kadus-VII-Sei-Rotan",
    category: "Full-Stack Web",
    highlight: "Real-time sync",
  },
  {
    title: "ML Prediction Deployment",
    description: "Platform monitoring deteksi diabetes berbasis Machine Learning yang dideploy menggunakan Flask API dan Docker container.",
