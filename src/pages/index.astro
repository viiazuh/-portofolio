// Certificates Data
const certs = [
  { id: 1, title: "Data Science Python", issuer: "SkillPedia", file: "/sertifikat-data-science-python.png", isPdf: false, tag: "Data Science" },
  { id: 2, title: "HTML & CSS", issuer: "SkillPedia", file: "/sertifikat-html-css.png", isPdf: false, tag: "Web Dev" },
  { id: 3, title: "Unity Game Platform", issuer: "SkillPedia", file: "/sertifikat-unity-platform.png", isPdf: false, tag: "Game Dev" },
  { id: 4, title: "Aplikasi Android Intermediate", issuer: "Dicoding", file: "/Android-Intermediate.png", isPdf: false, tag: "Android" },
  { id: 5, title: "Belajar Dasar AI", issuer: "Dicoding", file: "/Belajar-Dasar.Ai.png", isPdf: false, tag: "Artificial Intelligence" },
  { id: 6, title: "Fundamental Aplikasi Android", issuer: "Dicoding", file: "/Fundamental-Aplikasi-Android.png", isPdf: false, tag: "Android" },
  { id: 7, title: "Machine Learning Android", issuer: "Dicoding", file: "/ml-android.png", isPdf: false, tag: "ML & Android" },
  { id: 8, title: "RedHat Linux Certified", issuer: "Huawei", file: "/redhat.png", isPdf: false, tag: "Linux / DevOps" },
  { id: 9, title: "Kampus Merdeka Certified", issuer: "Huawei", file: "/sertifikat kampus merdeka.pdf", isPdf: true, tag: "Program Merdeka" },
];
---

<Layout title="Vio Azuhri | Cross-Platform Developer">
  <div class="relative overflow-hidden min-h-screen flex flex-col">
    
    <!-- BACKGROUND ATMOSPHERE & MESH DECORATION -->
    <div class="absolute inset-0 z-0 h-full w-full bg-white bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:16px_28px] pointer-events-none"></div>
    <div class="absolute top-12 left-10 w-[500px] h-[500px] bg-blue-400/15 rounded-full blur-[120px] pointer-events-none -z-10"></div>
    <div class="absolute top-[600px] right-10 w-[500px] h-[500px] bg-purple-400/15 rounded-full blur-[130px] pointer-events-none -z-10"></div>
    <div class="absolute top-[1600px] left-10 w-[500px] h-[500px] bg-amber-400/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <section id="hero" class="relative z-10 pt-4 md:pt-10 pb-16 min-h-[calc(100vh-80px)] flex flex-col justify-center">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">

        <!-- LEFT: Greeting & Identity & Quick Actions -->
        <div class="lg:col-span-4 text-center lg:text-left flex flex-col justify-center order-2 lg:order-1 gs-hero-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-slate-900 text-white rounded-full font-bold text-xs mb-5 shadow-lg shadow-slate-900/10 w-fit mx-auto lg:mx-0 hover:scale-105 transition-transform cursor-default">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            OPEN FOR WORK
          </div>

          <p class="text-slate-500 font-semibold text-lg md:text-xl tracking-wide mb-1">
            Hello! I'm
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-none mb-6">
            VIO<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-amber-500">
              AZUHRI
            </span>
          </h1>

          <p class="text-slate-600 text-sm md:text-base leading-relaxed mb-8 max-w-sm mx-auto lg:mx-0">
            Seorang <b>Cross-Platform Developer</b>. Membangun aplikasi web dan mobile
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            <a href="#projects" class="relative inline-flex items-center gap-2 px-7 py-3.5 font-bold text-white transition-all duration-200 bg-slate-900 rounded-full hover:bg-slate-800 text-sm shadow-lg shadow-slate-900/20 hover:shadow-slate-900/40 hover:-translate-y-0.5 group">
              VIEW PROJECTS
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <a href="/VioAzuhri.pdf" download="CV_Azuzu_FullStack.pdf" class="inline-flex items-center gap-2 px-6 py-3.5 font-bold text-slate-800 bg-white border-2 border-slate-200 rounded-full hover:border-blue-600 hover:text-blue-600 transition-all text-sm shadow-sm hover:-translate-y-0.5">
              Download CV
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

          <!-- CENTER: Seamless 3D Avatar -->
    <div id="hero-model-wrap" class="lg:col-span-4 relative flex items-center justify-center order-1 lg:order-2 my-0 gs-hero-center w-full">
      <div class="w-full max-w-[280px] sm:max-w-[350px] lg:max-w-[440px] relative">
        
        <!-- Panggil CUKUP 1 KALI saja -->
        <ModelViewer modelPath="/model.glb" />

      </div>
    </div>
        <!-- RIGHT: Big Typography Role & Metrics (Like Aden Kesuma) -->
        <div class="lg:col-span-4 text-center lg:text-left flex flex-col justify-center order-3 space-y-5 gs-hero-right">
          <div>
            <span class="text-xs uppercase tracking-widest font-extrabold text-indigo-600 block mb-1">
              Cross-Platform
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-none uppercase">
              DEVELOPER
            </h2>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-400 via-slate-600 to-slate-900 tracking-tight leading-none uppercase mt-1">
              INNOVATOR
            </h2>
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-3 pt-5 border-t border-slate-200/80 max-w-sm mx-auto lg:mx-0">
            <div class="p-3.5 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm text-center hover:shadow-md transition-all">
              <div class="text-2xl font-black text-slate-900">19+</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Projects</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm text-center hover:shadow-md transition-all">
              <div class="text-2xl font-black text-slate-900">9+</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Certificates</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm text-center hover:shadow-md transition-all">
              <div class="text-2xl font-black text-slate-900">3y</div>
              <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">Experience</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick Scroll Down Hint -->
      <div class="text-center pt-8 hidden md:block">
        <a href="#experience" class="inline-flex flex-col items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-slate-700 transition-colors">
          <span>EXPLORE JOURNEY</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>
    </section>


  <!-- WORK & EXPERIENCE SECTION (Fixed Layout & Added Animations)       -->

  <section id="experience" class="py-6 max-w-6xl mx-auto px-4 sm:px-6 md:px-8 mb-10">
    <div class="relative overflow-hidden rounded-3xl p-6 sm:p-10 border border-slate-200/80 bg-white/70 backdrop-blur-md shadow-xl shadow-slate-100/50">
      
      <!-- Section Header -->
      <div class="mb-8 md:mb-12 text-left">
        <span class="text-xs font-bold tracking-widest text-indigo-600 uppercase block mb-1">
          CAREER TIMELINE
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Work & Experience
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-xl">
          Rekam jejak pengalaman kerja, proyek mandiri, magang, dan peran profesional saya.
        </p>
      </div>

      <!-- Experience Items Timeline -->
      <div class="relative">
        <!-- Central Line for Desktop Only -->
        <div class="hidden md:block absolute left-1/2 top-3 bottom-3 w-0.5 -translate-x-1/2 bg-gradient-to-b from-indigo-500 via-purple-400 to-indigo-200"></div>

        <!-- 
          KONTAINER UTAMA:
          - Mobile: Flex Row Horizontal + Overflow Scroll X + Snap (Bisa Digeser)
          - Desktop (md:): Kembali ke Space-y-14 Normal
        -->
        <div class="flex overflow-x-auto gap-4 pb-6 snap-x snap-mandatory scrollbar-none md:block md:space-y-14 md:overflow-visible md:pb-0">
          {experiences.map((exp, index) => {
            const isEven = index % 2 === 0;
            return (
              /* 
                WRAPPER KARTU:
                - Mobile: min-w-[85vw] (Lebar 85% layar HP biar kartu berikutnya 'ngintip' di kanan) + shrink-0
                - Desktop (md:): Kembali ke flex-row / flex-row-reverse
              */
              <div class={`relative min-w-[85vw] sm:min-w-[65vw] shrink-0 snap-center md:min-w-0 md:shrink md:snap-none md:flex md:flex-col md:items-center md:justify-between ${isEven ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
                
                <!-- Content Box -->
                <div class="w-full md:w-[42%]">
                  <div class="group relative p-6 rounded-2xl bg-white/90 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-indigo-300 hover:-translate-y-1.5 transition-all duration-300 ease-out h-full">
                    
                    <!-- Top Accent Line on Hover -->
                    <div class="absolute top-0 left-6 right-6 h-0.5 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-t-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                    <div class="flex items-center justify-between gap-2 mb-2">
                      <h4 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                        {exp.role}
                      </h4>
                      <span class="md:hidden text-xs font-bold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-600 shrink-0">
                        {exp.period}
                      </span>
                    </div>

                    <p class="text-xs font-bold text-indigo-600 mb-3 tracking-wide uppercase">
                      {exp.company}
                    </p>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                      {exp.description}
                    </p>
                  </div>
                </div>

                <!-- Center Point Dot dengan Efek Pulsing Animation (Hanya Desktop) -->
                <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center justify-center z-10">
                  <span class="absolute inline-flex h-6 w-6 rounded-full bg-indigo-400/40 animate-ping"></span>
                  <div class="w-4 h-4 rounded-full bg-indigo-600 border-4 border-white shadow-md"></div>
                </div>

                <!-- Year/Period Label (Hanya Desktop) -->
                <div class={`hidden md:block w-[42%] ${isEven ? 'text-right pr-12' : 'text-left pl-12'}`}>
                  <span class="inline-block text-base font-extrabold text-slate-700 bg-slate-100/80 px-3.5 py-1.5 rounded-xl border border-slate-200/60 shadow-sm">
                    {exp.period}
                  </span>
                </div>

              </div>
            );
          })}
        </div>
      </div>

    </div>
  </section>
    <!-- 3. SERVICES SECTION (Sticky / Parallax ScrollTrigger Cards)        -->

    <section id="services" class="py-20 relative">
      <div class="text-center max-w-2xl mx-auto mb-16 gs-section-header">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 font-extrabold text-xs uppercase tracking-wider mb-3">
          Specializations
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
          Services &amp; <span class="text-blue-600">Expertise</span>
        </h2>
        <p class="text-slate-500 text-base mt-3">Layanan profesional yang saya tawarkan dengan fokus pada kecepatan, keamanan, dan skalabilitas.</p>
      </div>

      <!-- Sticky / Staggered Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto gs-services-cards">
        {skills.map((skill, idx) => (
          <div class={`service-card relative p-8 rounded-3xl bg-white border border-slate-200/90 shadow-xl shadow-slate-100/80 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 overflow-hidden group`}>
            <!-- Subtle Top Accent Gradient -->
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-blue-500 via-indigo-500 to-amber-500 opacity-80"></div>
            
            <div class="flex items-center justify-between mb-6">
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 text-slate-800 group-hover:scale-110 group-hover:bg-slate-900 group-hover:text-white transition-all shadow-sm" set:html={skill.icon} />
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-slate-100 text-slate-700">
                {skill.badge}
              </span>
            </div>

            <h3 class="text-2xl font-extrabold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors">
              {skill.title}
            </h3>

            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              {skill.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100">
              {skill.techs.map((tech) => (
                <span class="px-3 py-1 bg-slate-50 border border-slate-100 text-slate-700 rounded-lg text-xs font-semibold">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
    <!-- 4. FEATURED PROJECTS SECTION (Interactive Showcase)               -->
    <section id="projects" class="py-20 relative border-t border-slate-100">
      <div class="text-center max-w-2xl mx-auto mb-16 gs-section-header">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 font-extrabold text-xs uppercase tracking-wider mb-3">
          Selected Works
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
          Featured <span class="text-amber-500">Projects</span>
        </h2>
        <p class="text-slate-500 text-base mt-3">Koleksi proyek nyata yang saya rancang dan kembangkan.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto gs-projects-cards">
        {projects.map((p) => (
          <div class="project-card flex flex-col justify-between p-7 rounded-3xl bg-white border border-slate-200/90 shadow-lg shadow-slate-100 hover:shadow-2xl hover:border-amber-400/80 transition-all duration-300 group hover:-translate-y-2">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200/60">
                  {p.category}
                </span>
                <span class="text-xs font-semibold text-emerald-600 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  {p.highlight}
                </span>
              </div>

              <h3 class="text-xl font-black text-slate-900 mb-3 group-hover:text-amber-600 transition-colors">
                {p.title}
              </h3>

