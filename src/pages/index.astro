<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { TextPlugin } from 'gsap/TextPlugin';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger, TextPlugin);

  // ─────────────────────────────────────────────
  //  HELPERS
  // ─────────────────────────────────────────────

  function splitTextToWords(el: HTMLElement) {
    const words = el.innerText.trim().split(/\s+/);
    el.innerHTML = words
      .map(w => `<span class="reveal-word"><span>${w}&nbsp;</span></span>`)
      .join('');
    return el.querySelectorAll<HTMLElement>('.reveal-word span');
  }

  // ─────────────────────────────────────────────
  //  MAIN INIT
  // ─────────────────────────────────────────────

  function initAnimations() {

    // ── 1. LENIS SMOOTH SCROLL ────────────────────
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 0.9,
      touchMultiplier: 1.5,
    });

    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // ── 2. HERO SECTION ──────────────────────────

    const heroHeading = document.querySelector<HTMLElement>('#hero h1');
    if (heroHeading) {
      const words = splitTextToWords(heroHeading);
      gsap.fromTo(words,
        { y: '110%', opacity: 0 },
        { y: '0%', opacity: 1, duration: 1, stagger: 0.08, ease: 'expo.out', delay: 0.2 }
      );
    }

    gsap.fromTo('.gs-hero-left',
      { opacity: 0, x: -50, filter: 'blur(8px)' },
      { opacity: 1, x: 0, filter: 'blur(0px)', duration: 1.1, ease: 'expo.out', delay: 0.1 }
    );
    gsap.fromTo('.gs-hero-center',
      { opacity: 0, scale: 0.85, filter: 'blur(12px)' },
      { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 1.4, ease: 'back.out(1.4)', delay: 0.3 }
    );
    gsap.fromTo('.gs-hero-right',
      { opacity: 0, x: 50, filter: 'blur(8px)' },
      { opacity: 1, x: 0, filter: 'blur(0px)', duration: 1.1, ease: 'expo.out', delay: 0.5 }
    );

    // Hero model subtle parallax (HANYA posisi Y, TANPA opacity fade out agar model tetap 100% terlihat jelas)
    const heroModel = document.getElementById('hero-model-wrap');
    if (heroModel) {
      gsap.to(heroModel, {
        y: 50,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: 1,
        },
      });
    }

    // ── 3. EXPERIENCE TIMELINE LINE ──────────────

    const expLine = document.querySelector('.gs-timeline-line');
    if (expLine) {
      gsap.fromTo(expLine,
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: '#experience',
            start: 'top 60%',
            end: 'bottom 80%',
            scrub: true,
          }
        }
      );
    }

    // ── 4. SECTION HEADERS — word-by-word reveal ─

    document.querySelectorAll<HTMLElement>('.gs-section-header h2').forEach((h2) => {
      const words = splitTextToWords(h2);
      gsap.fromTo(words,
        { y: '110%', opacity: 0 },
        {
          y: '0%', opacity: 1,
          duration: 0.9, stagger: 0.06, ease: 'expo.out',
          scrollTrigger: { trigger: h2, start: 'top 88%', toggleActions: 'play none none reverse' }
        }
      );
    });

    document.querySelectorAll<HTMLElement>('.gs-section-header .inline-flex').forEach((badge) => {
      gsap.fromTo(badge,
        { opacity: 0, y: 20, scale: 0.9 },
        {
          opacity: 1, y: 0, scale: 1, duration: 0.7, ease: 'back.out(2)',
          scrollTrigger: { trigger: badge, start: 'top 90%', toggleActions: 'play none none reverse' }
        }
      );
    });

    document.querySelectorAll<HTMLElement>('.gs-section-header p').forEach((p) => {
      gsap.fromTo(p,
        { opacity: 0, y: 15 },
        {
          opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
          scrollTrigger: { trigger: p, start: 'top 90%', toggleActions: 'play none none reverse' }
        }
      );
    });

    // ── 5. MATCH MEDIA ────────────────────────────

    const mm = gsap.matchMedia();

    mm.add({
      isMobile:  '(max-width: 767px)',
      isDesktop: '(min-width: 768px)'
    }, (ctx) => {
      const { isMobile } = ctx.conditions as { isMobile: boolean };

      // Experience cards
      gsap.utils.toArray<HTMLElement>('.experience-card').forEach((card, i) => {
        gsap.fromTo(card,
          { opacity: 0, x: isMobile ? 30 : 70, y: 10 },
          {
            opacity: 1, x: 0, y: 0,
            duration: 0.9, ease: 'expo.out', delay: i * 0.08,
            scrollTrigger: {
              trigger: card, start: 'top 92%',
              toggleActions: 'play none none reverse',
            }
          }
        );
      });

      // Service cards
      const serviceCards = gsap.utils.toArray<HTMLElement>('.service-card');
      if (serviceCards.length) {
        gsap.fromTo(serviceCards,
          { opacity: 0, y: isMobile ? 30 : 60, scale: 0.93 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 0.9, stagger: isMobile ? 0.1 : 0.15, ease: 'expo.out',
            scrollTrigger: {
              trigger: '.gs-services-cards', start: 'top 85%',
              toggleActions: 'play none none reverse',
            }
          }
        );
      }

      // Project cards
      const projectCards = gsap.utils.toArray<HTMLElement>('.project-card');
      if (projectCards.length) {
        gsap.fromTo(projectCards,
          { opacity: 0, y: isMobile ? 40 : 70, rotateX: isMobile ? 0 : 8 },
          {
            opacity: 1, y: 0, rotateX: 0,
            duration: 0.9, stagger: 0.1, ease: 'expo.out',
            scrollTrigger: {
              trigger: '.gs-projects-grid', start: 'top 85%',
              toggleActions: 'play none none reverse',
            }
          }
        );
      }

      // Certificate cards — flip-in Y
      const certCards = gsap.utils.toArray<HTMLElement>('.cert-card');
      if (certCards.length) {
        gsap.fromTo(certCards,
          { opacity: 0, rotationY: isMobile ? 20 : 40, y: isMobile ? 30 : 50, transformPerspective: 1000 },
          {
            opacity: 1, rotationY: 0, y: 0,
            duration: 1, stagger: 0.08, ease: 'expo.out',
            scrollTrigger: {
              trigger: '.gs-certs-grid', start: 'top 88%',
              toggleActions: 'play none none reverse',
            }
          }
        );
      }

      // Contact card — elastic scale-in
      const contactCard = document.querySelector<HTMLElement>('.gs-contact-card');
      if (contactCard) {
        gsap.fromTo(contactCard,
          { opacity: 0, scale: isMobile ? 0.95 : 0.8, y: isMobile ? 30 : 60 },
          {
            opacity: 1, scale: 1, y: 0,
            duration: 1.3, ease: 'elastic.out(1, 0.65)',
            scrollTrigger: {
              trigger: contactCard, start: 'top 88%',
              toggleActions: 'play none none reverse',
            }
          }
        );
      }

      return () => {};
    });

    // ── 6. HOVER TILT on project / service cards ──

    document.querySelectorAll<HTMLElement>('.project-card, .service-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width  - 0.5) * 10;
        const y = ((e.clientY - rect.top)  / rect.height - 0.5) * -10;
        gsap.to(card, { rotateY: x, rotateX: y, duration: 0.4, ease: 'power2.out', transformPerspective: 800 });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, { rotateY: 0, rotateX: 0, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
      });
    });

    // ── 7. MODAL LOGIC ───────────────────────────

    const modal         = document.getElementById('cert-modal');
    const modalTitle    = document.getElementById('modal-title');
    const modalIssuer   = document.getElementById('modal-issuer');
    const modalIframe   = document.getElementById('modal-iframe')   as HTMLIFrameElement | null;
    const modalImg      = document.getElementById('modal-img')      as HTMLImageElement   | null;
    const modalDownload = document.getElementById('modal-download') as HTMLAnchorElement  | null;
    const modalClose    = document.getElementById('modal-close');
    const modalContent  = document.getElementById('modal-content');

    function openModal(title: string, issuer: string, file: string, isPdf: boolean) {
      if (!modal || !modalContent) return;
      if (modalTitle)    modalTitle.textContent  = title;
      if (modalIssuer)   modalIssuer.textContent = `Issued by: ${issuer}`;
      if (modalDownload) modalDownload.href       = file;

      if (isPdf && modalIframe && modalImg) {
        modalIframe.src = file;
        modalIframe.classList.remove('hidden');
        modalImg.classList.add('hidden');
      } else if (modalImg && modalIframe) {
        modalImg.src = file;
        modalImg.alt = title;
        modalImg.classList.remove('hidden');
        modalIframe.classList.add('hidden');
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');

      gsap.set(modalContent,  { scale: 0.85, opacity: 0, y: 30 });
      gsap.to(modalContent,   { scale: 1, opacity: 1, y: 0, duration: 0.5, ease: 'back.out(1.5)' });
    }

    function closeModal() {
      if (!modal || !modalContent) return;
      gsap.to(modalContent, {
        scale: 0.9, opacity: 0, y: 20, duration: 0.3, ease: 'power3.in',
        onComplete: () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          if (modalIframe) modalIframe.src = '';
          if (modalImg)    modalImg.src    = '';
        }
      });
    }

    document.querySelectorAll<HTMLElement>('.cert-card').forEach((card) => {
      card.addEventListener('click', () => {
        openModal(
          card.dataset.title  ?? '',
          card.dataset.issuer ?? '',
          card.dataset.file   ?? '',
          card.dataset.isPdf === 'true'
        );
      });
    });

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    // ── 8. MOBILE SHOWCASE TAB SWITCHER (SESUAI GAMBAR) ──
    const mobileTabs = document.querySelectorAll<HTMLButtonElement>('.mobile-showcase-tab');
    const mobilePanels = document.querySelectorAll<HTMLElement>('.mobile-tab-panel');

    function switchMobileTab(targetId: string) {
      mobileTabs.forEach((tab) => {
        const isTarget = tab.dataset.tabTarget === targetId;
        const iconDiv = tab.querySelector('div');
        if (isTarget) {
          tab.classList.add(
            'active-tab',
            'text-indigo-600',
            'bg-white',
            'border',
            'border-slate-200/90',
            'shadow-sm'
          );
          tab.classList.remove('text-slate-600', 'hover:bg-white/60');
          if (iconDiv) {
            iconDiv.classList.add('text-indigo-600');
            iconDiv.classList.remove('text-slate-500');
          }
        } else {
          tab.classList.remove(
            'active-tab',
            'text-indigo-600',
            'bg-white',
            'border',
            'border-slate-200/90',
            'shadow-sm'
          );
          tab.classList.add('text-slate-600', 'hover:bg-white/60');
          if (iconDiv) {
            iconDiv.classList.remove('text-indigo-600');
            iconDiv.classList.add('text-slate-500');
          }
        }
      });

      mobilePanels.forEach((panel) => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          gsap.fromTo(
            panel.children,
            { opacity: 0, y: 15 },
            { opacity: 1, y: 0, duration: 0.35, stagger: 0.05, ease: 'power2.out' }
          );
        } else {
          panel.classList.add('hidden');
        }
      });

      ScrollTrigger.refresh();
    }

    mobileTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tabTarget;
        if (target) switchMobileTab(target);
      });
    });

    // Sinkronisasi jika link navbar diklik di mobile (#projects, #certificates, #services)
    function checkHashForMobileTab() {
      const hash = window.location.hash;
      if (hash === '#projects') switchMobileTab('tab-projects');
      else if (hash === '#certificates') switchMobileTab('tab-certificates');
      else if (hash === '#services') switchMobileTab('tab-tech');
    }

    window.addEventListener('hashchange', checkHashForMobileTab);
    checkHashForMobileTab();

  } // end initAnimations

  // ─────────────────────────────────────────────
  //  BOOT
  // ─────────────────────────────────────────────

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.addEventListener('loaderComplete', initAnimations, { once: true });
      setTimeout(initAnimations, 3500);
    });
  } else {
    window.addEventListener('loaderComplete', initAnimations, { once: true });
    setTimeout(initAnimations, 3500);
  }

  document.addEventListener('astro:page-load', () => {
    initAnimations();
    ScrollTrigger.refresh();
  });
</script>
