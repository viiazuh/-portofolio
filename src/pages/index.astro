    <!-- 6. CONTACT SECTION (High-Impact Direct Email & Outreach)          -->
    <section id="contact" class="py-24 relative border-t border-slate-100">
      <div class="max-w-4xl mx-auto rounded-3xl p-8 sm:p-12 md:p-16 bg-slate-900 text-white text-center relative overflow-hidden shadow-2xl shadow-slate-900/30 gs-contact-card">
        <!-- Ambient internal glow -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-amber-400 font-bold text-xs uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
