---
// projects.astro — Projects page (converted from Projects.jsx)
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "Sistem Informasi Dusun",
    description: "Digitalisasi pengumuman warga & dokumentasi desa dengan Dashboard Admin real-time.",
    stack: ["React", "Firebase", "Cloudinary", "Dashboard"],
    link: "https://github.com/viiazuh/Web-Kadus-VII-Sei-Rotan",
    icon: "layout",
  },
  {
    title: "ML Prediction Deployment",
    description: "Web monitor diabetes dengan Flask & Docker.",
    stack: ["Flask", "Docker", "CI/CD", "React"],
    link: "https://github.com/viiazuh/diabetes-app_UTsDevops",
    icon: "database",
  },
  {
    title: "Mobile E-Wallet",
    description: "Aplikasi E-Wallet dengan Flutter UI/UX.",
    stack: ["Flutter", "Dart", "State Management"],
    link: "https://github.com/viiazuh/infoin_ewallet",
    icon: "smartphone",
  },
  {
    title: "25 Kisah Nabi",
    description: "Aplikasi Android Native Kotlin.",
    stack: ["Kotlin", "Android Native"],
    link: "https://github.com/viiazuh/25-prophets",
    icon: "smartphone",
  },
  {
    title: "PASA: Password Security",
    description: "Tim project deteksi keamanan password (ML).",
    stack: ["React", "Python", "ML"],
    link: "https://github.com/kentangbiru/PASA",
    icon: "layout",
  },
];

const icons: Record<string, string> = {
  layout: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>`,
  database: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>`,
  smartphone: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>`,
};
---

<Layout 
  title="Projects | Vio Azuhri"
  description="Featured projects by Vio Azuhri — Full-Stack & Mobile Developer"
>
  <div class="pt-12 pb-24 animate-fade-in-up">
    <header class="mb-10 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-2">
        Featured <span class="text-amber-500">Projects</span>
      </h1>
      <p class="text-lg text-slate-600">Karya terbaik saya.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {projects.map((p) => (
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-slate-100 hover:shadow-xl hover:border-amber-400 transition-all duration-300 group">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-slate-800 group-hover:text-amber-600 transition-colors">{p.title}</h3>
            <div class="text-slate-400 group-hover:text-amber-500" set:html={icons[p.icon]} />
          </div>
          <p class="text-slate-600 mb-4 text-base line-clamp-3">{p.description}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {p.stack.map(tech => (
              <span class="px-3 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-medium">{tech}</span>
            ))}
          </div>
          <a href={p.link} target="_blank" rel="noopener noreferrer" class="text-blue-600 font-semibold flex items-center hover:text-blue-800">
            Lihat Repository
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</Layout>
