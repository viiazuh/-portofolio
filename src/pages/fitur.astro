---
// src/pages/fitur.astro
// Halaman Penjelasan & Portal Akses Web Fitur (TikTok Downloader, Web Converter, dll)
// Anda dapat dengan mudah mengedit link server, jam operasional, dan daftar fitur di bawah ini!

import Layout from '../layouts/Layout.astro';

// ==========================================
// 1. KONFIGURASI URL WEB FITUR & SERVER
// ==========================================
const EXTERNAL_WEB_URL = "https://fitur.vioazuhri.online/";

// ==========================================
// 2. JADWAL AKTIF SERVER (WIB) - STB SERVER
// ==========================================
const operationalSchedules = [
  {
    sesi: "Jam Aktif Utama (ON)",
    jam: "Aktif Hampir 24 Jam",
    icon: "⚡",
    badge: "AKTIF",
    badgeColor: "bg-emerald-500/30 text-emerald-200 border-emerald-400/30",
    keterangan: "Server STB online melayani unduhan TikTok dan konversi file",
  },
  {
    sesi: "Jadwal Istirahat STB (OFF)",
    jam: "22:00 - 23:00 WIB",
    icon: "🌙",
    badge: "OFF (1 JAM)",
    badgeColor: "bg-amber-500/30 text-amber-200 border-amber-400/30",
    keterangan: "Pendinginan hardware mesin STB agar performa tetap prima dan awet",
  },
  {
    sesi: "Kondisi Mati Lampu (OFF)",
    jam: "Pemadaman Listrik",
    icon: "💡",
    badge: "KONDISIONAL",
    badgeColor: "bg-rose-500/30 text-rose-200 border-rose-400/30",
    keterangan: "Jika server mati di luar jam 22:00–23:00, kemungkinan mati lampu",
  },
];

// ==========================================
// 3. DAFTAR FITUR UTAMA YANG TERSEDIA
// ==========================================
const featureList = [
  {
    id: "tiktok-downloader",
    title: "TikTok Video Downloader",
    badge: "Populer",
    badgeColor: "bg-rose-50 text-rose-600 border-rose-200",
    url: "https://fitur.vioazuhri.online/downloader/",
    description: "Unduh video TikTok favoritmu tanpa watermark secara instan dan mudah. Hasil unduhan jernih kualitas HD langsung tersimpan di perangkatmu tanpa aplikasi tambahan.",
    highlights: ["Tanpa Watermark (No-WM)", "Cepat & Praktis", "Gratis Tanpa Batas"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-600"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>`,
    gradient: "from-rose-500/10 via-pink-500/5 to-transparent",
    borderHover: "hover:border-rose-400",
  },
  {
    id: "web-converter",
    title: "Web & Media Converter",
    badge: "Multifungsi",
    badgeColor: "bg-indigo-50 text-indigo-600 border-indigo-200",
    url: "https://fitur.vioazuhri.online/converter/",
    description: "Alat konversi serbaguna untuk mengubah berbagai format dokumen, gambar, atau media langsung di browser. Proses konversi cepat, aman, dan mudah tanpa perlu instal software berat.",
    highlights: ["Multi-Format Support", "Proses Cepat & Ringan", "Privasi Aman", "Langsung di Browser"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>`,
    gradient: "from-indigo-500/10 via-blue-500/5 to-transparent",
    borderHover: "hover:border-indigo-400",
  },
  
];
---

<Layout
  title="Web Fitur & Layanan Tools | Vio Azuhri"
  description="Portal informasi dan akses layanan web utilities Vio Azuhri: TikTok Video Downloader, Web Converter, dan jadwal jam operasional server."
  noLoader={true}
>
  <div class="py-12 md:py-16 max-w-5xl mx-auto space-y-12">
    
    <!-- Top Navigation Breadcrumb / Back Link -->
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-slate-500 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 px-4 py-2 rounded-full border border-slate-200/80 transition-all duration-200 group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Kembali ke Portofolio</span>
      </a>

      <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        <span>Portal Informasi Fitur</span>
      </div>
    </div>

    <!-- Hero Header -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Selamat Datang di <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-amber-500 bg-clip-text text-transparent">Layanan Web Fitur</span>
      </h1>

      <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed">
        Halaman ini dibuat agar kamu mengetahui informasi lengkap mengenai fitur apa saja yang tersedia, jadwal jam aktif server, serta status pengembangannya sebelum langsung membuka aplikasi.
      </p>
    </header>

    <!-- DAFTAR FITUR YANG TERSEDIA (DITARUH DI PALING ATAS UNTUK MEMPERMUDAH PENGGUNA) -->
    <section class="space-y-6 pt-2">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold">
          <span>⚡</span>
          <span>PILIH ALAT YANG INGIN DIGUNAKAN</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Alat Bantu & Fitur Online
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Klik tombol pada kartu di bawah untuk langsung menggunakan alat:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {featureList.map((fitur) => (
          <div class={`bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm hover:shadow-xl ${fitur.borderHover} transition-all duration-300 flex flex-col justify-between relative overflow-hidden group`}>
            <!-- Top Gradient Accent -->
            <div class={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r ${fitur.gradient}`}></div>

            <div class="space-y-4">
              <!-- Top bar icon & badge -->
              <div class="flex items-center justify-between">
                <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 group-hover:scale-110 transition-transform" set:html={fitur.icon} />
                <span class={`text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full border ${fitur.badgeColor}`}>
                  {fitur.badge}
                </span>
              </div>

              <!-- Title & Description -->
              <div class="space-y-2">
                <h3 class="text-lg font-black text-slate-900 group-hover:text-indigo-600 transition-colors">
                  {fitur.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {fitur.description}
                </p>
              </div>

              <!-- Key Highlights / Tags -->
              <div class="flex flex-wrap gap-1.5 pt-2">
                {fitur.highlights.map((tag) => (
                  <span class="text-[11px] font-semibold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
                    ✓ {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Button Langsung di Dalam Kartu -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500">Aplikasi Siap Digunakan</span>
              <a
                href={fitur.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/20 hover:shadow-lg transition-all"
              >
                <span>Buka Alat</span>
                <span class="group-hover:translate-x-0.5 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- LIVE SERVER STATUS & JAM OPERASIONAL WIDGET -->
    <section class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 md:p-10 shadow-2xl relative overflow-hidden border border-slate-800">
      <!-- Glow ambient background effect -->
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-8">
        <!-- Status Bar Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/10">
          <div>
            <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-indigo-300 uppercase mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Server Monitoring (WIB)</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-white">Jadwal Jam Aktif Server</h2>
          </div>

          <!-- Dynamic Live Badge (Dihitung Realtime oleh Script di bawah) -->
          <div class="flex flex-col sm:items-end gap-1.5">
            <div id="live-server-status" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="live-status-text">MENGECEK JADWAL SERVER...</span>
            </div>
            <span id="live-clock-text" class="text-[11px] font-mono text-slate-400">Waktu WIB: Memuat...</span>
          </div>
        </div>

        <!-- 3 Sesi Jam Aktif -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {operationalSchedules.map((item) => (
            <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-5 hover:bg-white/10 hover:border-indigo-400/50 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-2xl">{item.icon}</span>
                  <span class={`text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full border ${item.badgeColor}`}>
                    {item.badge}
                  </span>
                </div>
                <div class="text-xl font-black text-white font-mono tracking-tight group-hover:text-amber-300 transition-colors">
                  {item.jam}
                </div>
              </div>
              <p class="text-xs text-slate-300 mt-3 leading-relaxed border-t border-white/5 pt-3">
                {item.keterangan}
              </p>
            </div>
          ))}
        </div>

        <!-- Callout Penjelasan Server Gratis & Mandiri -->
        <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-5 flex items-start gap-4 text-slate-200">
          <div class="p-2.5 rounded-xl bg-amber-500/20 text-amber-300 flex-shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="space-y-1 text-xs sm:text-sm">
            <h3 class="font-bold text-amber-300 text-sm sm:text-base">Catatan Penting: Jadwal Off Server STB</h3>
            <p class="text-slate-300 leading-relaxed">
              Layanan ini dijalankan dari <strong>Server STB (Set-Top Box) pribadi</strong> via Cloudflare Tunnel. Server beroperasi aktif dan <strong>hanya OFF pada jam 22:00 – 23:00 WIB (10 malam – 11 malam)</strong> untuk waktu istirahat & pendinginan mesin. Jika server tidak dapat diakses di luar jam 22:00–23:00 tersebut, kemungkinan besar sedang terjadi <strong>pemadaman listrik (mati lampu)</strong> setempat. Terima kasih atas pengertiannya!
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- PANDUAN PENGGUNAAN & KONTEN EDUKASI FITUR -->
    <section class="space-y-8 bg-white rounded-3xl p-6 sm:p-8 md:p-10 border border-slate-200/90 shadow-sm">
      <div class="space-y-3 border-b border-slate-100 pb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold">
          <span>📖</span>
          <span>Panduan Penggunaan & Informasi Lengkap</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
          Cara Menggunakan Layanan & Keunggulan Fitur
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed max-w-3xl">
          Pelajari bagaimana setiap utilitas di web ini bekerja, panduan langkah demi langkah, serta komitmen kami terhadap privasi dan keamanan data Anda.
        </p>
      </div>

      <!-- Artikel Fitur 1: TikTok Downloader -->
      <article class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-black">
            01
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Panduan Mengunduh Video TikTok Tanpa Watermark
          </h3>
        </div>
        <p class="text-sm text-slate-600 leading-relaxed">
          TikTok Downloader adalah utilitas berbasis web yang dirancang khusus untuk membantu konten kreator, pelajar, dan penikmat konten dalam menyimpan video favorit untuk keperluan tontonan offline, analisis konten, atau referensi kreatif.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1.5">
            <span class="text-xs font-black text-indigo-600 font-mono">LANGKAH 1</span>
            <h4 class="text-sm font-bold text-slate-900">Salin Link Video</h4>
            <p class="text-xs text-slate-500">Buka aplikasi TikTok, pilih video yang diinginkan, klik tombol Bagikan (Share), lalu tekan opsi Salin Tautan (Copy Link).</p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1.5">
            <span class="text-xs font-black text-indigo-600 font-mono">LANGKAH 2</span>
            <h4 class="text-sm font-bold text-slate-900">Tempel di Kolom Input</h4>
            <p class="text-xs text-slate-500">Buka aplikasi web fitur kami, tempelkan tautan yang sudah Anda salin ke kolom input yang tersedia di halaman utama.</p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1.5">
            <span class="text-xs font-black text-indigo-600 font-mono">LANGKAH 3</span>
            <h4 class="text-sm font-bold text-slate-900">Simpan Video HD</h4>
            <p class="text-xs text-slate-500">Klik tombol Proses / Unduh. Video berkualitas tinggi tanpa watermark akan langsung terunduh ke penyimpanan perangkat Anda.</p>
          </div>
        </div>
      </article>

      <!-- Artikel Fitur 2: Web & Media Converter -->
      <article class="space-y-4 pt-6 border-t border-slate-100">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-black">
            02
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Panduan Konversi Berkas & Media Serbaguna
          </h3>
        </div>
        <p class="text-sm text-slate-600 leading-relaxed">
          Mengubah format dokumen atau media sering kali membutuhkan software rumit berukuran besar. Web Converter kami memberikan solusi instan langsung dari browser tanpa perlu menginstal aplikasi tambahan di komputer atau ponsel pintar Anda.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
            <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span class="text-emerald-500">✓</span> Kompatibilitas Ragam Format
            </h4>
            <p class="text-xs text-slate-500 leading-relaxed">
              Mendukung berbagai ekstensi dokumen populer seperti PDF, DOCX, XLSX, format gambar seperti JPG, PNG, WebP, hingga berkas audio dan video ringan untuk kebutuhan harian.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
            <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span class="text-emerald-500">✓</span> Keamanan & Privasi Maksimal
            </h4>
            <p class="text-xs text-slate-500 leading-relaxed">
              Semua proses konversi berkas dijalankan secara sementara di memori tanpa disimpan di server kami. Privasi dan kerahasiaan dokumen Anda terjamin sepenuhnya.
            </p>
          </div>
        </div>
      </article>
    </section>

    <!-- BANNER IKLAN SPONSOR (ADSTERRA) -->
    <section class="bg-gradient-to-b from-white to-slate-50/80 rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm relative overflow-hidden space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 text-[11px] font-bold">
            <span>🛡️</span>
            <span>KEMITRAAN SPONSOR</span>
          </div>
          <h3 class="text-base sm:text-lg font-black text-slate-900">
            Dukungan Operasional Layanan
          </h3>
          <p class="text-xs text-slate-500 max-w-xl leading-relaxed">
            Layanan ini disediakan gratis untuk publik dan didukung melalui penayangan iklan sponsor untuk pemeliharaan server.
          </p>
        </div>
      </div>

      <!-- Area Slot Iklan Adsterra -->
      <div class="w-full flex flex-col items-center justify-center pt-1 overflow-hidden">
        <!-- Label Iklan -->
        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mb-2">
          IKLAN / SPONSOR
        </span>

        <div class="w-full flex justify-center items-center min-h-[90px] overflow-hidden">
          <script is:inline async fetchpriority="high" data-cfasync="false" src="https://bauval.org/21/58d5063210a651be41d61e96c68d6c12"></script>
          <div id="container-58d5063210a651be41d61e96c68d6c12"></div>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION (PERTANYAAN YANG SERING DIAJUKAN) -->
    <section class="space-y-6 bg-white rounded-3xl p-6 sm:p-8 md:p-10 border border-slate-200/90 shadow-sm">
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
          Pertanyaan yang Sering Diajukan (FAQ)
        </h2>
        <p class="text-sm text-slate-500">
          Jawaban atas beberapa pertanyaan teknis dan operasional terkait situs web fitur:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <h3 class="text-sm font-bold text-slate-900">Apakah layanan ini benar-benar gratis?</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Ya, seluruh utilitas yang ada di situs ini dapat digunakan secara cuma-cuma tanpa biaya pendaftaran maupun batasan jumlah unduhan atau konversi harian.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <h3 class="text-sm font-bold text-slate-900">Mengapa video hasil unduhan tidak ada watermark?</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Sistem kami memproses stream video murni langsung dari sumber aslinya sebelum lapisan watermark disematkan oleh aplikasi, sehingga video yang Anda simpan jernih dan bersih.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <h3 class="text-sm font-bold text-slate-900">Mengapa server hanya aktif pada jam tertentu?</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Karena saat ini kami masih menggunakan server lokal pribadi via Cloudflare Tunnel untuk tahap uji coba awal. Jadwal di atas disusun agar server bekerja optimal saat jam produktif Anda.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
          <h3 class="text-sm font-bold text-slate-900">Apakah file yang saya konversi disimpan di server?</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Tidak. Kami menerapkan kebijakan zero-storage retention di mana seluruh file dihapus seketika setelah proses konversi selesai dan berhasil diunduh ke browser Anda.
          </p>
        </div>
      </div>
    </section>

    <!-- TOMBOL AKSES UTAMA MENUJU WEB CLOUDFLARE -->
    <section class="bg-gradient-to-r from-indigo-50 via-white to-amber-50 rounded-3xl p-8 sm:p-10 border border-indigo-100 text-center space-y-6 shadow-sm">
      <div class="max-w-2xl mx-auto space-y-3">
