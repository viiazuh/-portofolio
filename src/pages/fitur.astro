</Layout>

<!-- Client Script untuk Menghitung Status Jadwal Aktif Server Secara Realtime -->
<script>
  function updateServerStatus() {
    const statusContainer = document.getElementById("live-server-status");
    const statusText = document.getElementById("live-status-text");
    const clockText = document.getElementById("live-clock-text");

    if (!statusContainer || !statusText || !clockText) return;

    // Ambil waktu saat ini dalam WIB (UTC+7)
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const wibDate = new Date(utc + (3600000 * 7));

    const hours = wibDate.getHours();
    const minutes = wibDate.getMinutes();
    const seconds = wibDate.getSeconds();

    const timeString = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')} WIB`;
    clockText.textContent = `Waktu Sekarang: ${timeString}`;

    // Jadwal Operasional:
    // 1. Pagi: 07:00 - 12:00 (hours >= 7 && hours < 12)
    // 2. Siang/Sore: 13:00 - 17:00 (hours >= 13 && hours < 17)
    // 3. Malam: 19:00 - 24:00 (hours >= 19 && hours < 24)
    const isOnline = 
      (hours >= 7 && hours < 12) ||
      (hours >= 13 && hours < 17) ||
      (hours >= 19 && hours < 24);

    if (isOnline) {
      statusContainer.className = "inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/40";
      statusText.textContent = "SERVER STATUS: ONLINE (SEDANG AKTIF)";
    } else {
      statusContainer.className = "inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-black bg-amber-500/20 text-amber-300 border border-amber-500/40";
      statusText.textContent = "SERVER STATUS: STANDBY / DI LUAR JADWAL";
    }
  }

  // Update pertama kali & jalankan interval tiap detik
  updateServerStatus();
  setInterval(updateServerStatus, 1000);
</script>

