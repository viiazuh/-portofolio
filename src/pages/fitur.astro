    sesi: "Sesi Pagi",
    jam: "07:00 - 12:00 WIB",
    startHour: 7,
    endHour: 12,
    icon: "🌅",
    keterangan: "Online untuk aktivitas pagi & unduhan cepat",
  },
  {
    sesi: "Sesi Siang / Sore",
    jam: "13:00 - 17:00 WIB",
    startHour: 13,
    endHour: 17,
    icon: "☀️",
    keterangan: "Online untuk konversi file & kebutuhan kerja",
  },
  {
    sesi: "Sesi Malam",
    jam: "19:00 - 24:00 WIB",
    startHour: 19,
    endHour: 24,
    icon: "🌙",
    keterangan: "Online santai hingga tengah malam",
  },
];

// ==========================================
// 3. DAFTAR FITUR UTAMA YANG TERSEDIA
// ==========================================
const featureList = [
  {
    id: "tiktok-downloader",
    title: "TikTok Video Downloader",
    badge: "Populer",
    badgeColor: "bg-rose-50 text-rose-600 border-rose-200",
    description: "Unduh video TikTok favoritmu tanpa watermark secara instan dan mudah. Hasil unduhan jernih kualitas HD langsung tersimpan di perangkatmu tanpa aplikasi tambahan.",
    highlights: ["Tanpa Watermark (No-WM)", "Cepat & Praktis", "Gratis Tanpa Batas"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-600"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>`,
    gradient: "from-rose-500/10 via-pink-500/5 to-transparent",
    borderHover: "hover:border-rose-400",
  },
  {
    id: "web-converter",
    title: "Web & Media Converter",
    badge: "Multifungsi",
    badgeColor: "bg-indigo-50 text-indigo-600 border-indigo-200",
    description: "Alat konversi serbaguna untuk mengubah berbagai format dokumen, gambar, atau media langsung di browser. Proses konversi cepat, aman, dan mudah tanpa perlu instal software berat.",
    highlights: ["Multi-Format Support", "Proses Cepat & Ringan", "Privasi Aman", "Langsung di Browser"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>`,
    gradient: "from-indigo-500/10 via-blue-500/5 to-transparent",
    borderHover: "hover:border-indigo-400",
