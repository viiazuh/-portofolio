// ==========================================
// 2. KONFIGURASI GOOGLE ADSENSE (via .env)
// ==========================================
// Dibaca dari file .env — TIDAK ter-upload ke GitHub (aman!)
// Edit nilai di file .env, bukan di sini.
const ADSENSE_CLIENT_ID = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID ?? "";
const ADSENSE_SLOT_ID   = import.meta.env.PUBLIC_ADSENSE_SLOT_ID   ?? "";

// ==========================================
// 3. JADWAL AKTIF SERVER (WIB)
// ==========================================
