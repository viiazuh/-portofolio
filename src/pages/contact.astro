---
// contact.astro — Contact page (converted from Contact.jsx)
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact | Vio Azuhri"
  description="Get in touch with Vio Azuhri — Full-Stack & Mobile Developer"
>
  <div class="pt-12 pb-24 animate-fade-in-up">
    <div class="p-12 bg-white min-h-[50vh] rounded-2xl shadow-lg border border-slate-100 text-center flex flex-col justify-center items-center">
      <h1 class="text-4xl font-extrabold text-slate-900 mb-4">CONTACT ME</h1>
      <p class="text-xl text-slate-600 mb-8">Saya terbuka untuk project baru. Mari kita diskusikan kebutuhan Anda!</p>
      <a 
        href="mailto:sequadtaswan@gmail.com"
        class="px-8 py-4 bg-amber-500 text-white rounded-full font-bold shadow-xl shadow-amber-500/30 hover:bg-amber-600 transition-transform hover:-translate-y-1 flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        EMAIL SAYA SEKARANG
      </a>
    </div>
  </div>
</Layout>
