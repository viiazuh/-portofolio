---
// Layout.astro - Shared layout for all pages
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SpaceBackground from "../components/SpaceBackground.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noLoader?: boolean;
}

const {
  title = "Vio Azuhri | Cross-Platform Developer",
  description = "Portfolio of Vio Azuhri — Cross-Platform Developer specializing in Kotlin, Flutter, React, Vue, and modern architectures.",
  noLoader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/foto.svg" />
    <link rel="icon" href="/foto.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="bg-[#070714] text-slate-100 antialiased selection:bg-purple-500 selection:text-white overflow-x-hidden min-h-screen relative"
  >
    <!-- Three.js Cosmic Starfield & Meteor Background -->
    <SpaceBackground />

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress"></div>
    {!noLoader && (
      <div
        id="loader"
        class="fixed inset-0 z-[9999] bg-[#070714] flex flex-col items-center justify-center overflow-hidden"
      >
        <!-- Decorative background elements -->
        <div
          class="loader-circle absolute w-[150vw] h-[150vw] rounded-full bg-purple-950/30 -z-10 scale-0"
        >
        </div>

        <div class="loader-content flex flex-col items-center relative z-10">
          <!-- Modern spinning abstract logo with Cosmic Glow -->
          <div class="loader-icon mb-10 relative w-20 h-20">
            <div
              class="absolute inset-0 border-[3px] border-purple-500/20 rounded-full"
            >
            </div>
            <div
              class="absolute inset-0 border-[3px] border-cyan-400 rounded-full border-t-transparent animate-spin shadow-[0_0_15px_#38bdf8]"
            >
            </div>
            <div
              class="absolute inset-2 border-[3px] border-purple-500 rounded-full border-b-transparent animate-[spin_1.5s_linear_infinite_reverse]"
            >
            </div>
            <div
              class="absolute inset-4 bg-purple-950 rounded-full flex items-center justify-center border border-purple-500/30"
            >
              <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-ping"></span>
            </div>
          </div>

          <!-- Animated typography -->
          <div class="overflow-hidden mb-6 flex space-x-1">
            <h1
              class="loader-title text-xl font-black text-white tracking-[0.2em] uppercase translate-y-full"
            >
              Sabar Rek
            </h1>
          </div>

          <div
            class="loader-bar-wrap w-56 md:w-72 h-1 bg-purple-950/60 border border-purple-500/30 rounded-full overflow-hidden shadow-inner relative"
          >
            <div
              class="loader-bar absolute left-0 top-0 bottom-0 bg-gradient-to-r from-purple-500 via-cyan-400 to-indigo-500 w-0"
            >
            </div>
          </div>

          <div
            class="loader-percentage text-[10px] font-bold text-purple-300 mt-4 tracking-widest flex items-center gap-2"
          >
            <span
              class="inline-block w-1 h-1 bg-cyan-400 rounded-full animate-pulse"
            ></span>
            <span id="perc-text">0%</span>
          </div>
        </div>
      </div>
    )}
    <Navbar />
    <main class="w-full max-w-[1440px] 2xl:max-w-[1520px] mx-auto px-4 sm:px-8 lg:px-12" id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener("DOMContentLoaded", () => {
        const loader = document.getElementById("loader");
        const loaderBar = document.querySelector(".loader-bar");
        const percText = document.getElementById("perc-text");
        const mainContent = document.getElementById("main-content");

        if (loader && loaderBar && percText && mainContent) {
          document.body.style.overflow = "hidden";
          gsap.set(mainContent, { opacity: 0, y: 30, scale: 0.98 });

          gsap.to(".loader-title", {
            y: 0,
            duration: 0.8,
            ease: "power4.out",
            delay: 0.2,
          });
          gsap.to(".loader-circle", {
            scale: 1,
            duration: 2,
            ease: "power2.out",
          });

          const tl = gsap.timeline({
            onComplete: () => {
              document.body.style.overflow = "";
              loader.style.display = "none";
              ScrollTrigger.refresh();
              window.dispatchEvent(new Event("loaderComplete"));
            },
          });

          tl.to(loaderBar, {
            width: "100%",
            duration: 2.2,
            ease: "power3.inOut",
            onUpdate: function () {
              const progress = Math.round(this.progress() * 100);
              percText.textContent = progress + "%";
            },
          })
            .to(".loader-content", {
              scale: 0.9,
              opacity: 0,
              duration: 0.6,
              ease: "power3.in",
            }, "-=0.3")
            .to(loader, {
              yPercent: -100,
              duration: 1,
              ease: "expo.inOut",
              borderRadius: "0 0 50% 50%",
            })
            .to(mainContent, {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 1.2,
              ease: "expo.out",
              clearProps: "transform",
            }, "-=0.7");
        } else {
          document.body.style.overflow = "";
          ScrollTrigger.refresh();
          window.dispatchEvent(new Event("loaderComplete"));
        }

        // ── Scroll Progress Bar ──
        const progressBar = document.getElementById("scroll-progress");
        if (progressBar) {
          gsap.to(progressBar, {
            scaleX: 1,
            ease: "none",
            scrollTrigger: {
              trigger: document.body,
              start: "top top",
              end: "bottom bottom",
              scrub: 0.3,
            },
          });
        }
      });
    </script>
  </body>
</html>
