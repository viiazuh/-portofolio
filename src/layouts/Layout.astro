---
// Layout.astro - Shared layout for all pages
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Vio Azuhri | Cross-Platform Developer",
  description = "Portfolio of Vio Azuhri — Cross-Platform Developer specializing in Kotlin, Flutter, React, Vue, and modern architectures.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/foto.svg" />
    <link rel="icon" href="/foto.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="bg-white text-slate-900 antialiased selection:bg-amber-400 selection:text-slate-900 overflow-x-hidden"
  >
    <Navbar />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
