---
// Layout.astro - Shared layout for all pages
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Vio Azuhri | Cross-Platform Developer",
  description = "Portfolio of Vio Azuhri — Cross-Platform Developer specializing in Kotlin, Flutter, React, Vue, and modern architectures.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/foto.svg" />
    <link rel="icon" href="/foto.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class="bg-white text-slate-900 antialiased selection:bg-amber-400 selection:text-slate-900 overflow-x-hidden"
  >
    <div id="loader" class="fixed inset-0 z-[9999] bg-white flex flex-col items-center justify-center overflow-hidden">
      <!-- Decorative background elements -->
      <div class="loader-circle absolute w-[150vw] h-[150vw] rounded-full bg-slate-50 -z-10 scale-0"></div>
      
      <div class="loader-content flex flex-col items-center relative z-10">
        <!-- Modern spinning abstract logo -->
        <div class="loader-icon mb-10 relative w-20 h-20">
          <div class="absolute inset-0 border-[3px] border-indigo-100 rounded-full"></div>
          <div class="absolute inset-0 border-[3px] border-amber-500 rounded-full border-t-transparent animate-spin"></div>
          <div class="absolute inset-2 border-[3px] border-indigo-500 rounded-full border-b-transparent animate-[spin_1.5s_linear_infinite_reverse]"></div>
          <div class="absolute inset-4 bg-slate-900 rounded-full flex items-center justify-center">
             <span class="w-1.5 h-1.5 bg-white rounded-full animate-ping"></span>
          </div>
        </div>
        
        <!-- Animated typography -->
        <div class="overflow-hidden mb-6 flex space-x-1">
          <h1 class="loader-title text-xl font-black text-slate-800 tracking-[0.2em] uppercase translate-y-full">
            INITIALIZING
          </h1>
        </div>

        <div class="loader-bar-wrap w-56 md:w-72 h-1 bg-slate-100 rounded-full overflow-hidden shadow-inner relative">
          <div class="loader-bar absolute left-0 top-0 bottom-0 bg-gradient-to-r from-indigo-500 via-purple-500 to-amber-500 w-0"></div>
        </div>
        
        <div class="loader-percentage text-[10px] font-bold text-slate-400 mt-4 tracking-widest flex items-center gap-2">
          <span class="inline-block w-1 h-1 bg-amber-500 rounded-full animate-pulse"></span>
          <span id="perc-text">0%</span>
        </div>
      </div>
    </div>
    <Navbar />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12" id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener('DOMContentLoaded', () => {
        document.body.style.overflow = 'hidden';
        
        const loaderBar = document.querySelector('.loader-bar');
        const percText = document.getElementById('perc-text');
        const loader = document.getElementById('loader');
        const mainContent = document.getElementById('main-content');
        
        if (loaderBar && percText && loader && mainContent) {
          gsap.set(mainContent, { opacity: 0, y: 30, scale: 0.98 });
          
          // Initial Entrance animations for loader
          gsap.to('.loader-title', { y: 0, duration: 0.8, ease: 'power4.out', delay: 0.2 });
          gsap.to('.loader-circle', { scale: 1, duration: 2, ease: 'power2.out' });
          
          const tl = gsap.timeline({
            onComplete: () => {
              document.body.style.overflow = '';
              loader.style.display = 'none';
              ScrollTrigger.refresh();
              window.dispatchEvent(new Event('loaderComplete'));
            }
          });
          
          tl.to(loaderBar, {
            width: '100%',
            duration: 2.2,
            ease: 'power3.inOut',
            onUpdate: function() {
              const progress = Math.round(this.progress() * 100);
              percText.textContent = progress + '%';
            }
          })
          .to('.loader-content', {
            scale: 0.9,
            opacity: 0,
            duration: 0.6,
            ease: 'power3.in'
          }, "-=0.3")
          .to(loader, {
            yPercent: -100, // Slide up the whole loader screen
            duration: 1,
            ease: 'expo.inOut',
            borderRadius: '0 0 50% 50%' // add cool curving effect as it goes up
          })
          .to(mainContent, {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 1.2,
            ease: 'expo.out',
            clearProps: "transform"
          }, "-=0.7");
        } else {
           window.dispatchEvent(new Event('loaderComplete'));
        }
      });
    </script>
  </body>
</html>
