---
// Navbar.astro — Sticky Glassmorphic Navigation with Smooth ScrollSpy
const navLinks = [
  { id: "hero", label: "Home", href: "/#hero" },
  { id: "experience", label: "Experience", href: "/#experience" },
  { id: "services", label: "Services", href: "/#services" },
  { id: "projects", label: "Projects", href: "/#projects" },
  { id: "certificates", label: "Certificates", href: "/#certificates" },
  { id: "contact", label: "Contact", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 w-full bg-white/85 backdrop-blur-md border-b border-slate-100/90 transition-all shadow-[0_2px_15px_rgba(0,0,0,0.03)]">
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex justify-between items-center h-20">
    <!-- Logo -->
    <a href="/#hero" class="flex items-center gap-2.5 no-underline group">
      <div class="bg-slate-900 text-white p-2.5 rounded-xl group-hover:scale-105 transition-transform shadow-md shadow-slate-900/10">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </div>
      <span class="text-xl font-black tracking-tight text-slate-900">
        Vio<span class="text-amber-500">Stack</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav id="desktop-nav" class="hidden md:flex items-center gap-1 bg-slate-50/80 p-1.5 rounded-full border border-slate-200/60 shadow-inner">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-section={link.id}
            class="nav-link px-5 py-2 rounded-full text-xs font-bold tracking-wider text-slate-600 transition-all duration-200 hover:text-slate-900 hover:bg-white/80"
          >
            {link.label.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <!-- Quick CTA Button -->
    <div class="hidden md:flex items-center">
      <a
        href="/#contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold text-white bg-slate-900 hover:bg-amber-600 hover:shadow-lg hover:shadow-amber-500/20 transition-all duration-300"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        LET'S TALK
      </a>
    </div>

    <!-- Mobile Toggle -->
    <div class="md:hidden flex items-center">
      <button
        id="menu-toggle"
        class="p-2.5 bg-slate-100/80 border border-slate-200/80 rounded-xl text-slate-700 hover:text-slate-900 transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          id="icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          id="icon-close"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="nav-menu"
    class="hidden md:hidden absolute top-full left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-slate-200 shadow-xl px-6 py-6 flex-col gap-2 transition-all animate-fade-in-up"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          data-section={link.id}
          class="nav-link block py-3 px-4 rounded-xl text-sm font-bold text-slate-700 hover:text-amber-600 hover:bg-slate-50 transition-colors"
        >
          {link.label}
        </a>
      ))
    }
    <div class="pt-3 mt-2 border-t border-slate-100">
      <a
        href="/#contact"
        class="nav-link flex items-center justify-center gap-2 w-full py-3.5 rounded-xl text-sm font-bold text-white bg-slate-900 shadow-lg shadow-slate-900/20"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        LET'S TALK
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavigation() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("nav-menu");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");

    // Toggle Mobile Menu
    toggle?.addEventListener("click", () => {
      const isOpen = !menu?.classList.contains("hidden");
      menu?.classList.toggle("hidden", isOpen);
      menu?.classList.toggle("flex", !isOpen);
      iconMenu?.classList.toggle("hidden", !isOpen);
      iconClose?.classList.toggle("hidden", isOpen);
    });

    // Smooth Scroll on anchor click when on same page
    navLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (href && href.includes("#")) {
          const targetId = href.split("#")[1];
          const targetEl = document.getElementById(targetId);
          if (targetEl && window.location.pathname === "/") {
            e.preventDefault();
            // Close mobile menu
            menu?.classList.add("hidden");
            menu?.classList.remove("flex");
            iconMenu?.classList.remove("hidden");
            iconClose?.classList.add("hidden");

            // Smooth scroll with offset for sticky navbar
            const navHeight = 85;
            const elementPosition = targetEl.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - navHeight;

            // Ensure all cards in target section are immediately 100% visible
            targetEl.querySelectorAll<HTMLElement>('.service-card, .project-card, .cert-card, .gs-section-header, .gs-contact-card').forEach((el) => {
              el.style.opacity = '1';
              el.style.transform = 'none';
            });

            window.scrollTo({
              top: offsetPosition,
              behavior: "smooth"
            });

            // Update URL hash without jumping
            history.pushState(null, "", `#${targetId}`);
          }
        }
      });
    });

    // Active Section ScrollSpy
    const sections = ["hero", "experience", "services", "projects", "certificates", "contact"];
    const sectionEls = sections
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    function updateActiveNav() {
      const scrollPos = window.scrollY + 180;
      let currentSectionId = "hero";

      sectionEls.forEach((section) => {
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentSectionId = section.id;
        }
      });

      // Update link styles
      navLinks.forEach((link) => {
        const sec = link.dataset.section;
        if (sec === currentSectionId) {
          link.classList.add("text-slate-900", "bg-white", "shadow-sm");
          link.classList.remove("text-slate-600");
        } else {
          link.classList.remove("text-slate-900", "bg-white", "shadow-sm");
          link.classList.add("text-slate-600");
        }
      });
    }

    window.addEventListener("scroll", updateActiveNav, { passive: true });
    updateActiveNav();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavigation);
  } else {
    setupNavigation();
  }
  document.addEventListener("astro:page-load", setupNavigation);
</script>
