---
// ModelViewer.astro — Interactive 3D Astronaut Monkey & Mini Solar System in Three.js
interface Props {
  modelPath?: string;
  height?: string;
}
const { modelPath = "/model.glb", height = "560px" } = Astro.props;
---

<div
  class="model-container model-wrapper"
  data-model-path={modelPath}
  style={`height: ${height}`}
>
  <!-- Ambient Cosmic Nebula Glow -->
  <div class="model-aura-glow"></div>

  <canvas class="model-canvas"></canvas>

  <!-- Interactive Hint -->
  <div class="model-hint">
    <span class="hint-dot"></span>
    <span>Drag to rotate • Click for Space Spin</span>
  </div>
</div>

<style>
  .model-wrapper {
    position: relative;
    width: 100%;
    background: transparent;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    transform: translateZ(0);
  }

  .model-aura-glow {
    position: absolute;
    width: 320px;
    height: 320px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(168, 85, 247, 0.28) 0%,
      rgba(59, 130, 246, 0.18) 40%,
      rgba(6, 182, 212, 0.08) 60%,
      transparent 75%
    );
    filter: blur(40px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    animation: cosmic-aura 7s ease-in-out infinite alternate;
  }

  @keyframes cosmic-aura {
    0% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.6; }
    100% { transform: translate(-50%, -50%) scale(1.15); opacity: 0.95; }
  }

  .model-canvas {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }

  .model-canvas:active {
    cursor: grabbing;
  }

  .model-hint {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    color: rgba(226, 232, 240, 0.85);
    background: rgba(15, 12, 38, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 6px 16px;
    border-radius: 9999px;
    border: 1px solid rgba(168, 85, 247, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 15px rgba(168, 85, 247, 0.15);
    letter-spacing: 0.03em;
    white-space: nowrap;
    pointer-events: none;
    z-index: 5;
    transition: opacity 0.5s ease;
  }

  .hint-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
</style>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";

  function initAstronautMonkeyViewers() {
    const containers = document.querySelectorAll(".model-container");

    containers.forEach((container) => {
      if (!(container instanceof HTMLElement)) return;
      if ((container as any)._sceneActive) return;
      (container as any)._sceneActive = true;

      const canvas = container.querySelector(".model-canvas");
      if (!(canvas instanceof HTMLCanvasElement)) return;

      const isMobile = window.innerWidth < 768;

      // ── Renderer ───────────────────────────────────────────────────────────
      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.25;

      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(
        42,
        container.clientWidth / container.clientHeight,
        0.1,
        100
      );
      camera.position.set(0, 0.2, 5.2);

      // ── Space Lighting ─────────────────────────────────────────────────────
      const ambientLight = new THREE.AmbientLight(0xd8b4fe, 0.85); // soft cosmic violet
      scene.add(ambientLight);

      const mainLight = new THREE.DirectionalLight(0xffffff, 2.0); // key star light
      mainLight.position.set(4, 5, 4);
      scene.add(mainLight);

      const cyanRim = new THREE.DirectionalLight(0x06b6d4, 2.2); // cyan space reflection
      cyanRim.position.set(-4, 2, -2);
      scene.add(cyanRim);

      const purpleRim = new THREE.DirectionalLight(0xa855f7, 2.5); // purple nebula back rim
      purpleRim.position.set(0, -3, -3);
      scene.add(purpleRim);

      // ── Master Group for Astronaut Monkey & System ─────────────────────────
      const monkeySystem = new THREE.Group();
      scene.add(monkeySystem);

      // ───────────────────────────────────────────────────────────────────────
      //  BUILDING PROCEDURAL 3D ASTRONAUT MONKEY
      // ───────────────────────────────────────────────────────────────────────
      const astronaut = new THREE.Group();

      // Materials
      const furMaterial = new THREE.MeshStandardMaterial({
        color: 0x6b3e26, // rich warm monkey brown
        roughness: 0.8,
        metalness: 0.1,
      });

      const faceMaterial = new THREE.MeshStandardMaterial({
        color: 0xfbd2a4, // peach/cream muzzle
        roughness: 0.6,
      });

      const eyeMaterial = new THREE.MeshStandardMaterial({
        color: 0x050505,
        roughness: 0.1,
        metalness: 0.9,
      });

      const eyeHighlightMat = new THREE.MeshBasicMaterial({
        color: 0xffffff,
      });

      const suitMaterial = new THREE.MeshStandardMaterial({
        color: 0xf8fafc, // crisp spacesuit white
        roughness: 0.35,
        metalness: 0.25,
      });

      const goldVisorCollarMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b, // amber gold collar
        roughness: 0.2,
        metalness: 0.85,
      });

      const glassMaterial = new THREE.MeshPhysicalMaterial({
        color: 0xbae6fd,
        transmission: 0.85,
        opacity: 0.38,
        transparent: true,
        roughness: 0.08,
        ior: 1.45,
        reflectivity: 0.9,
        clearcoat: 1.0,
        clearcoatRoughness: 0.1,
      });

      const cyanEmissiveMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
      });

      const purpleEmissiveMat = new THREE.MeshBasicMaterial({
        color: 0xc084fc,
      });

      // 1. Monkey Head & Face
      const headGroup = new THREE.Group();
      headGroup.position.set(0, 0.45, 0);

      // Head Base Sphere
      const headMesh = new THREE.Mesh(new THREE.SphereGeometry(0.52, 28, 28), furMaterial);
      headGroup.add(headMesh);

      // Muzzle / Snout (Cream face)
      const snout = new THREE.Mesh(new THREE.SphereGeometry(0.32, 24, 24), faceMaterial);
      snout.scale.set(1.15, 0.85, 0.9);
      snout.position.set(0, -0.1, 0.3);
      headGroup.add(snout);

      // Nose tip
      const nose = new THREE.Mesh(new THREE.SphereGeometry(0.065, 12, 12), new THREE.MeshBasicMaterial({ color: 0x27170e }));
      nose.position.set(0, -0.02, 0.58);
      headGroup.add(nose);

      // Eyes (left & right)
      [-0.17, 0.17].forEach((x) => {
        const eye = new THREE.Mesh(new THREE.SphereGeometry(0.085, 16, 16), eyeMaterial);
        eye.position.set(x, 0.07, 0.46);
        headGroup.add(eye);

        // Catchlight (white highlight)
        const shine = new THREE.Mesh(new THREE.SphereGeometry(0.025, 8, 8), eyeHighlightMat);
        shine.position.set(x + 0.025, 0.095, 0.53);
        headGroup.add(shine);
      });

      // Ears (left & right)
      [-0.52, 0.52].forEach((x) => {
        const ear = new THREE.Mesh(new THREE.SphereGeometry(0.2, 16, 16), furMaterial);
        ear.scale.set(0.4, 0.9, 0.9);
        ear.position.set(x, 0.05, 0);
        headGroup.add(ear);

        const innerEar = new THREE.Mesh(new THREE.SphereGeometry(0.12, 16, 16), faceMaterial);
        innerEar.scale.set(0.3, 0.7, 0.7);
        innerEar.position.set(x > 0 ? x - 0.03 : x + 0.03, 0.05, 0.05);
        headGroup.add(innerEar);
      });

      // 2. Astronaut Helmet (Glass Bubble Dome)
      const helmet = new THREE.Mesh(new THREE.SphereGeometry(0.8, 32, 32), glassMaterial);
      helmet.position.set(0, 0.45, 0);
      astronaut.add(helmet);

      // Helmet Base Rim Collar (Gold)
      const helmetCollar = new THREE.Mesh(new THREE.TorusGeometry(0.68, 0.08, 16, 32), goldVisorCollarMat);
      helmetCollar.rotation.x = Math.PI / 2;
      helmetCollar.position.set(0, -0.22 + 0.45, 0);
      astronaut.add(helmetCollar);

      // Astronaut Antenna on Helmet
      const antennaStem = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 0.28, 8), goldVisorCollarMat);
      antennaStem.position.set(0.25, 1.25, 0);
      antennaStem.rotation.z = -0.25;
      astronaut.add(antennaStem);

      const antennaTip = new THREE.Mesh(new THREE.SphereGeometry(0.05, 12, 12), cyanEmissiveMat);
      antennaTip.position.set(0.31, 1.38, 0);
      astronaut.add(antennaTip);

      astronaut.add(headGroup);

      // 3. Astronaut Spacesuit (Body) sitting atop Rocket Cockpit
      const suitBody = new THREE.Group();
      suitBody.position.set(0, -0.32, 0);

      // Torso
      const torso = new THREE.Mesh(new THREE.CylinderGeometry(0.52, 0.42, 0.75, 24), suitMaterial);
      suitBody.add(torso);

      // Chest Life Support Control Panel
      const chestPanel = new THREE.Mesh(
        new THREE.BoxGeometry(0.36, 0.24, 0.12),
        new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.2, metalness: 0.8 })
      );
      chestPanel.position.set(0, 0.12, 0.48);
      suitBody.add(chestPanel);

      // LED Indicators on chest panel
      const led1 = new THREE.Mesh(new THREE.SphereGeometry(0.035, 8, 8), cyanEmissiveMat);
      led1.position.set(-0.11, 0.15, 0.55);
      suitBody.add(led1);

      const led2 = new THREE.Mesh(new THREE.SphereGeometry(0.035, 8, 8), new THREE.MeshBasicMaterial({ color: 0x10b981 }));
      led2.position.set(0, 0.15, 0.55);
      suitBody.add(led2);

      const led3 = new THREE.Mesh(new THREE.SphereGeometry(0.035, 8, 8), new THREE.MeshBasicMaterial({ color: 0xf59e0b }));
      led3.position.set(0.11, 0.15, 0.55);
      suitBody.add(led3);

      // 4. Arms Holding Rocket Steering Handles / Waving
      // Left Arm (waving excitement)
      const leftArm = new THREE.Group();
      leftArm.position.set(-0.52, 0.12, 0);
      const leftUpperArm = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.11, 0.45, 16), suitMaterial);
      leftUpperArm.position.set(-0.18, 0.14, 0.12);
      leftUpperArm.rotation.z = 0.7;
      leftArm.add(leftUpperArm);

      const leftGlove = new THREE.Mesh(new THREE.SphereGeometry(0.14, 16, 16), goldVisorCollarMat);
      leftGlove.position.set(-0.35, 0.36, 0.2);
      leftArm.add(leftGlove);
      suitBody.add(leftArm);

      // Right Arm (gripping rocket joystick/handle)
      const rightArm = new THREE.Group();
      rightArm.position.set(0.52, 0.12, 0);
      const rightUpperArm = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.11, 0.42, 16), suitMaterial);
      rightUpperArm.position.set(0.16, -0.05, 0.18);
      rightUpperArm.rotation.z = -0.45;
      rightUpperArm.rotation.x = 0.5;
      rightArm.add(rightUpperArm);

      const rightGlove = new THREE.Mesh(new THREE.SphereGeometry(0.14, 16, 16), goldVisorCollarMat);
      rightGlove.position.set(0.26, -0.25, 0.38);
      rightArm.add(rightGlove);
      suitBody.add(rightArm);

      astronaut.add(suitBody);

      // ───────────────────────────────────────────────────────────────────────
      //  5. SLEEK RETRO-CYBER SPACE ROCKET (Monyet Naik Roket!)
      // ───────────────────────────────────────────────────────────────────────
      const rocket = new THREE.Group();
      rocket.position.set(0, -0.75, 0); // Positioned directly under monkey

      // Rocket Main Fuselage Body
      const rocketBodyMat = new THREE.MeshStandardMaterial({
        color: 0xede9fe, // futuristic pearl white / lavender
        roughness: 0.25,
        metalness: 0.65,
      });

      const rocketAccentMat = new THREE.MeshStandardMaterial({
        color: 0x8b5cf6, // cyber purple accent
        roughness: 0.3,
        metalness: 0.7,
      });

      const rocketCyanMat = new THREE.MeshStandardMaterial({
        color: 0x06b6d4, // cyan racing stripes
        roughness: 0.3,
        metalness: 0.8,
      });

      // Rocket Fuselage (Tapered Cylinder)
      const fuselage = new THREE.Mesh(
        new THREE.CylinderGeometry(0.65, 0.52, 1.35, 28),
        rocketBodyMat
      );
      fuselage.position.set(0, -0.35, 0);
      rocket.add(fuselage);

      // Rocket Nose Cone Top Rim (Cockpit border where monkey sits)
      const cockpitRim = new THREE.Mesh(
        new THREE.TorusGeometry(0.66, 0.08, 16, 32),
        rocketAccentMat
      );
      cockpitRim.rotation.x = Math.PI / 2;
      cockpitRim.position.set(0, 0.32, 0);
      rocket.add(cockpitRim);

      // Glowing Neon Stripe Ring around Rocket
      const neonStripe = new THREE.Mesh(
        new THREE.CylinderGeometry(0.655, 0.655, 0.08, 28),
        cyanEmissiveMat
      );
      neonStripe.position.set(0, -0.3, 0);
      rocket.add(neonStripe);

      // Secondary Purple Stripe Ring
      const purpleStripe = new THREE.Mesh(
        new THREE.CylinderGeometry(0.61, 0.61, 0.08, 28),
        purpleEmissiveMat
      );
      purpleStripe.position.set(0, -0.55, 0);
      rocket.add(purpleStripe);

      // Rocket Cockpit Porthole Window on Front
      const portholeRim = new THREE.Mesh(
        new THREE.TorusGeometry(0.2, 0.04, 12, 24),
        goldVisorCollarMat
      );
      portholeRim.position.set(0, -0.1, 0.63);
      rocket.add(portholeRim);

      const portholeGlass = new THREE.Mesh(
        new THREE.CircleGeometry(0.18, 24),
        new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.8 })
      );
      portholeGlass.position.set(0, -0.1, 0.635);
      rocket.add(portholeGlass);

      // Rocket Control Joystick on Cockpit
      const stickBase = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.06, 0.15, 12), goldVisorCollarMat);
      stickBase.position.set(0.22, 0.3, 0.38);
      stickBase.rotation.x = 0.3;
      rocket.add(stickBase);

      const stickKnob = new THREE.Mesh(new THREE.SphereGeometry(0.06, 12, 12), cyanEmissiveMat);
      stickKnob.position.set(0.22, 0.4, 0.42);
      rocket.add(stickKnob);

      // Rocket Wings / Stabilizer Fins (3 Wings placed around body)
      const finMat = new THREE.MeshStandardMaterial({
        color: 0x7c3aed, // deep purple wing
        roughness: 0.25,
        metalness: 0.75,
      });

      const wingShape = new THREE.Shape();
      wingShape.moveTo(0, 0);
      wingShape.lineTo(0.55, -0.5);
      wingShape.lineTo(0.48, -0.85);
      wingShape.lineTo(0, -0.7);
      wingShape.closePath();

      const extrudeSettings = { depth: 0.05, bevelEnabled: true, bevelSegments: 2, steps: 1, bevelSize: 0.02, bevelThickness: 0.02 };
      const finGeo = new THREE.ExtrudeGeometry(wingShape, extrudeSettings);

      // Fin 1: Left Wing
      const fin1 = new THREE.Mesh(finGeo, finMat);
      fin1.position.set(-0.55, -0.3, 0);
      fin1.rotation.y = Math.PI;
      rocket.add(fin1);

      // Fin 2: Right Wing
      const fin2 = new THREE.Mesh(finGeo, finMat);
      fin2.position.set(0.55, -0.3, 0);
      rocket.add(fin2);

      // Fin 3: Back Fin
      const fin3 = new THREE.Mesh(finGeo, finMat);
      fin3.position.set(0, -0.3, -0.55);
      fin3.rotation.y = -Math.PI / 2;
      rocket.add(fin3);

      // Rocket Engine Thruster Nozzle
      const rocketNozzle = new THREE.Mesh(
        new THREE.CylinderGeometry(0.32, 0.46, 0.35, 24),
        new THREE.MeshStandardMaterial({ color: 0x1e1b4b, roughness: 0.3, metalness: 0.9 })
      );
      rocketNozzle.position.set(0, -1.15, 0);
      rocket.add(rocketNozzle);

      // Rocket Thruster Fire Flame (Pulsing Cone)
      const flameMat = new THREE.MeshBasicMaterial({
        color: 0x38bdf8,
        transparent: true,
        opacity: 0.9,
      });
      const flame = new THREE.Mesh(
        new THREE.ConeGeometry(0.35, 1.1, 20),
        flameMat
      );
      flame.rotation.x = Math.PI; // pointing downwards
      flame.position.set(0, -1.8, 0);
      rocket.add(flame);

      // Inner Core Flame (hot yellow/white core)
      const innerFlame = new THREE.Mesh(
        new THREE.ConeGeometry(0.18, 0.75, 16),
        new THREE.MeshBasicMaterial({ color: 0xfef08a, transparent: true, opacity: 0.95 })
      );
      innerFlame.rotation.x = Math.PI;
      innerFlame.position.set(0, -1.6, 0);
      rocket.add(innerFlame);

      // Attach rocket directly to astronaut group
      astronaut.add(rocket);

      // Floating Space Cord / Tail connected behind monkey
      const curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(0, -0.3, -0.4),
        new THREE.Vector3(-0.25, -0.6, -0.6),
        new THREE.Vector3(0.1, -0.9, -0.7),
        new THREE.Vector3(-0.15, -1.2, -0.85),
      ]);
      const cordMesh = new THREE.Mesh(
        new THREE.TubeGeometry(curve, 20, 0.035, 8, false),
        goldVisorCollarMat
      );
      astronaut.add(cordMesh);

      // Add astronaut + rocket combo to system
      monkeySystem.add(astronaut);

      // ───────────────────────────────────────────────────────────────────────
      //  MINI SOLAR SYSTEM (PLANETS ORBITING ASTRONAUT MONKEY)
      // ───────────────────────────────────────────────────────────────────────
      // 1. Saturn-like Ringed Planet
      const saturnOrbit = new THREE.Group();
      const saturnPlanet = new THREE.Mesh(
        new THREE.SphereGeometry(0.38, 24, 24),
        new THREE.MeshStandardMaterial({
          color: 0xf59e0b, // amber
          roughness: 0.5,
          metalness: 0.1,
        })
      );
      // Saturn Ring
      const ringGeo = new THREE.RingGeometry(0.5, 0.82, 32);
      const ringMat = new THREE.MeshBasicMaterial({
        color: 0xfde047,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.75,
      });
      const ring = new THREE.Mesh(ringGeo, ringMat);
      ring.rotation.x = Math.PI / 2.3;
      saturnPlanet.add(ring);

      saturnPlanet.position.set(2.4, 0.7, -0.6);
      saturnOrbit.add(saturnPlanet);
      scene.add(saturnOrbit);

      // 2. Cyan Cyber Gas Planet
      const cyanPlanetOrbit = new THREE.Group();
      const cyanPlanet = new THREE.Mesh(
        new THREE.SphereGeometry(0.24, 24, 24),
        new THREE.MeshStandardMaterial({
          color: 0x06b6d4, // glowing cyan
          roughness: 0.3,
          metalness: 0.4,
          emissive: 0x0891b2,
          emissiveIntensity: 0.3,
        })
      );
      cyanPlanet.position.set(-2.2, -0.5, 0.4);
      cyanPlanetOrbit.add(cyanPlanet);
      scene.add(cyanPlanetOrbit);

      // 3. Tiny Violet Moon
      const moonOrbit = new THREE.Group();
      const violetMoon = new THREE.Mesh(
        new THREE.SphereGeometry(0.12, 16, 16),
        new THREE.MeshStandardMaterial({
          color: 0xc084fc, // purple
          roughness: 0.7,
        })
      );
      violetMoon.position.set(1.4, -1.2, 0.8);
      moonOrbit.add(violetMoon);
      scene.add(moonOrbit);

      // ── OrbitControls ──────────────────────────────────────────────────────
      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.minDistance = 2.5;
      controls.maxDistance = 7.0;
      controls.enablePan = false;
      controls.enableZoom = false;

      let isInteracting = false;
      canvas.addEventListener("pointerdown", () => { isInteracting = true; });
      window.addEventListener("pointerup", () => {
        setTimeout(() => { isInteracting = false; }, 800);
      });

      // Click to barrel roll / spin!
      let spinVelocity = 0;
      canvas.addEventListener("click", () => {
        spinVelocity = 0.28;
      });

      // Mouse Looking
      let mouseX = 0, mouseY = 0;
      if (!isMobile) {
        window.addEventListener("mousemove", (e) => {
          mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
          mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
        });
      }

      // ── Resize ─────────────────────────────────────────────────────────────
      function onResize() {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      }
      window.addEventListener("resize", onResize);

      // ── Render Loop ─────────────────────────────────────────────────────────
      let isVisible = true;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => { isVisible = e.isIntersecting; });
        },
        { threshold: 0.1 }
      );
      observer.observe(container);

      let prevTime = performance.now();

      function animate() {
        requestAnimationFrame(animate);
        if (!isVisible) return;

        const now = performance.now();
        const delta = (now - prevTime) * 0.001;
        prevTime = now;
        const time = now * 0.001;

        // Thruster Flame Pulsing Animation
        const flamePulse = 1 + Math.sin(time * 24) * 0.15;
        flame.scale.set(flamePulse, 1 + Math.cos(time * 28) * 0.25, flamePulse);
        innerFlame.scale.set(flamePulse * 0.9, 1 + Math.sin(time * 30) * 0.3, flamePulse * 0.9);

        // Zero-G & Thruster Jet Vibration
        const floatY = Math.sin(time * 2.2) * 0.14;
        const swayZ = Math.sin(time * 1.5) * 0.05;
        const engineVibe = (Math.random() - 0.5) * 0.015;
        astronaut.position.y = floatY + engineVibe;
        astronaut.rotation.z = swayZ;

        // Waving Left Arm in excitement
        leftArm.rotation.z = 0.7 + Math.sin(time * 4) * 0.2;

        // Interactive Click Spin (Barrel Roll)
        if (spinVelocity > 0.001) {
          astronaut.rotation.y += spinVelocity;
          spinVelocity *= 0.94; // damping
        } else if (!isInteracting) {
          // Smooth Mouse Follow Yaw & Pitch
          const targetY = mouseX * 0.45;
          const targetX = mouseY * -0.25;
          astronaut.rotation.y += (targetY - astronaut.rotation.y) * 0.06;
          astronaut.rotation.x += (targetX - astronaut.rotation.x) * 0.06;
        }

        // Orbiting Mini Solar System
        saturnOrbit.rotation.y += 0.008;
        saturnPlanet.rotation.y += 0.015;

        cyanPlanetOrbit.rotation.y -= 0.012;
        cyanPlanet.rotation.y += 0.02;

        moonOrbit.rotation.y += 0.018;

        controls.update();
        renderer.render(scene, camera);
      }

      animate();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAstronautMonkeyViewers);
  } else {
    initAstronautMonkeyViewers();
  }
  document.addEventListener("astro:page-load", initAstronautMonkeyViewers);
</script>
