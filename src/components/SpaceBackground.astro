---
// SpaceBackground.astro — Ultra-premium Three.js space: galaxy + interactive particles + aurora
---

<div id="space-bg-container" class="fixed inset-0 pointer-events-none -z-20 overflow-hidden">
  <canvas id="space-bg-canvas" class="w-full h-full block"></canvas>

  <!-- Aurora / Nebula CSS layers -->
  <div class="aurora-layer aurora-1"></div>
  <div class="aurora-layer aurora-2"></div>
  <div class="aurora-layer aurora-3"></div>

  <!-- Grid overlay subtle -->
  <div class="grid-overlay"></div>
</div>

<!-- Custom cursor glow (desktop only) -->
<div id="cursor-glow" class="pointer-events-none fixed z-[9999] hidden md:block"></div>

<style>
  #space-bg-container {
    background: radial-gradient(ellipse at 20% 10%, #0d0a22 0%, #070714 55%, #040310 100%);
  }

  /* ── Aurora / Nebula layers ───────────────────── */
  .aurora-layer {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
    filter: blur(90px);
  }
  .aurora-1 {
    width: 80vw; height: 70vw;
    top: -20%; left: -20%;
    background: radial-gradient(ellipse, rgba(139,92,246,0.18) 0%, rgba(99,102,241,0.08) 50%, transparent 70%);
    animation: aurora-drift 20s ease-in-out infinite alternate;
  }
  .aurora-2 {
    width: 70vw; height: 60vw;
    top: 30%; right: -15%;
    background: radial-gradient(ellipse, rgba(6,182,212,0.14) 0%, rgba(56,189,248,0.07) 50%, transparent 70%);
    animation: aurora-drift 25s ease-in-out infinite alternate-reverse;
    animation-delay: -8s;
  }
  .aurora-3 {
    width: 90vw; height: 60vw;
    bottom: -25%; left: 5%;
    background: radial-gradient(ellipse, rgba(168,85,247,0.12) 0%, rgba(236,72,153,0.06) 50%, transparent 70%);
    animation: aurora-drift 30s ease-in-out infinite alternate;
    animation-delay: -15s;
  }

  @keyframes aurora-drift {
    0%   { transform: scale(1) translate(0, 0) rotate(0deg); opacity: 0.7; }
    33%  { transform: scale(1.12) translate(30px, -20px) rotate(3deg); opacity: 1; }
    66%  { transform: scale(0.95) translate(-20px, 30px) rotate(-2deg); opacity: 0.85; }
    100% { transform: scale(1.08) translate(10px, -15px) rotate(1deg); opacity: 0.9; }
  }

  /* ── Subtle grid ─────────────────────────────── */
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(168,85,247,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(168,85,247,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.6) 0%, transparent 80%);
  }

  /* ── Custom cursor glow ──────────────────────── */
  #cursor-glow {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168,85,247,0.12) 0%, rgba(56,189,248,0.06) 40%, transparent 70%);
    transform: translate(-50%, -50%);
    transition: width 0.3s, height 0.3s, opacity 0.3s;
    pointer-events: none;
  }
</style>

<script>
  import * as THREE from "three";

  /* ─────────────────────────── Custom Cursor Glow ─────────────────────────── */
  const cursorGlow = document.getElementById("cursor-glow");
  if (cursorGlow && window.innerWidth >= 768) {
    document.addEventListener("mousemove", (e) => {
      cursorGlow.style.left = e.clientX + "px";
      cursorGlow.style.top  = e.clientY + "px";
    });
    document.addEventListener("mouseenter", () => { cursorGlow.style.opacity = "1"; });
    document.addEventListener("mouseleave", () => { cursorGlow.style.opacity = "0"; });

    // Bigger glow on interactive elements
    document.querySelectorAll("a,button,.cosmic-card,.project-card,.service-card").forEach((el) => {
      el.addEventListener("mouseenter", () => {
        cursorGlow.style.width  = "500px";
        cursorGlow.style.height = "500px";
        (cursorGlow.style as any).background = "radial-gradient(circle, rgba(56,189,248,0.18) 0%, rgba(168,85,247,0.08) 40%, transparent 70%)";
      });
      el.addEventListener("mouseleave", () => {
        cursorGlow.style.width  = "300px";
        cursorGlow.style.height = "300px";
        (cursorGlow.style as any).background = "radial-gradient(circle, rgba(168,85,247,0.12) 0%, rgba(56,189,248,0.06) 40%, transparent 70%)";
      });
    });
  }

  /* ─────────────────────────── Three.js Space Scene ───────────────────────── */
  function initSpaceBackground() {
    const canvas = document.getElementById(
      "space-bg-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    if ((canvas as any)._initialized) return;
    (canvas as any)._initialized = true;

    const isMobile = window.innerWidth < 768;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.2 : 1.8));
    renderer.setSize(window.innerWidth, window.innerHeight);

    const scene  = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 1, 1500);
    camera.position.z = 500;

    /* ── Shared particle texture ─────────────────────────────────────────── */
    function makeParticleTex(size = 32, glow = false): THREE.Texture {
      const c  = document.createElement("canvas");
      c.width  = size;
      c.height = size;
      const ctx = c.getContext("2d")!;
      const h   = size / 2;
      const g   = ctx.createRadialGradient(h, h, 0, h, h, h);
      if (glow) {
        g.addColorStop(0,   "rgba(255,255,255,1)");
        g.addColorStop(0.2, "rgba(200,200,255,0.9)");
        g.addColorStop(0.5, "rgba(150,100,255,0.4)");
        g.addColorStop(1,   "rgba(0,0,0,0)");
      } else {
        g.addColorStop(0,   "rgba(255,255,255,1)");
        g.addColorStop(0.4, "rgba(255,255,255,0.7)");
        g.addColorStop(1,   "rgba(0,0,0,0)");
      }
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, size, size);
      return new THREE.CanvasTexture(c);
    }

    const starTex  = makeParticleTex(16, false);
    const glowTex  = makeParticleTex(32, true);

    /* ── 1. BASE STARFIELD ───────────────────────────────────────────────── */
    const starCount = isMobile ? 800 : 2000;
    {
      const geo = new THREE.BufferGeometry();
      const pos = new Float32Array(starCount * 3);
      const col = new Float32Array(starCount * 3);
      const palette = [
        new THREE.Color("#ffffff"), new THREE.Color("#c084fc"),
        new THREE.Color("#818cf8"), new THREE.Color("#38bdf8"),
        new THREE.Color("#fde047"), new THREE.Color("#f9a8d4"),
      ];
      for (let i = 0; i < starCount; i++) {
        pos[i*3]   = (Math.random()-0.5) * 1600;
        pos[i*3+1] = (Math.random()-0.5) * 1600;
        pos[i*3+2] = (Math.random()-0.5) * 1000;
        const c = palette[Math.floor(Math.random() * palette.length)];
        col[i*3]=c.r; col[i*3+1]=c.g; col[i*3+2]=c.b;
      }
      geo.setAttribute("position", new THREE.BufferAttribute(pos,3));
      geo.setAttribute("color",    new THREE.BufferAttribute(col,3));
      const mat = new THREE.PointsMaterial({
        size: isMobile ? 2.8 : 3.5, map: starTex, vertexColors: true,
        transparent: true, opacity: 0.88, blending: THREE.AdditiveBlending, depthWrite: false,
      });
      scene.add(new THREE.Points(geo, mat));
    }

    /* ── 2. SPIRAL GALAXY (tilted Milky Way) ────────────────────────────── */
    const galaxyCount = isMobile ? 1000 : 4000;
    const galaxyPoints = (() => {
      const geo = new THREE.BufferGeometry();
      const pos = new Float32Array(galaxyCount * 3);
      const col = new Float32Array(galaxyCount * 3);
      const R = isMobile ? 300 : 420;
      const branches = 3, spin = 1.2, power = 3.5;
      const cIn  = new THREE.Color("#ff66dd");
      const cMid = new THREE.Color("#a855f7");
      const cOut = new THREE.Color("#38bdf8");
      for (let i = 0; i < galaxyCount; i++) {
        const r = Math.random() * R;
        const angle = ((i % branches) / branches) * Math.PI * 2 + r * spin * 0.01;
        const rnd = (v: number) => Math.pow(Math.random(), power) * (Math.random()<0.5?1:-1) * v;
        pos[i*3]   = Math.cos(angle)*r + rnd(0.45*r);
        pos[i*3+1] = rnd(0.22*r);
        pos[i*3+2] = Math.sin(angle)*r + rnd(0.45*r);
        const t = r/R;
        const mc = t < 0.4 ? cIn.clone().lerp(cMid, t/0.4) : cMid.clone().lerp(cOut,(t-0.4)/0.6);
        col[i*3]=mc.r; col[i*3+1]=mc.g; col[i*3+2]=mc.b;
      }
      geo.setAttribute("position", new THREE.BufferAttribute(pos,3));
      geo.setAttribute("color",    new THREE.BufferAttribute(col,3));
      const mat = new THREE.PointsMaterial({
        size: isMobile ? 1.6 : 2.4, map: starTex, vertexColors: true,
        transparent: true, opacity: isMobile ? 0.42 : 0.72,
        blending: THREE.AdditiveBlending, depthWrite: false,
      });
      const pts = new THREE.Points(geo, mat);
      pts.rotation.x = Math.PI / 3.2;
      pts.rotation.z = Math.PI / 6;
      pts.position.set(60, -20, -80);
      scene.add(pts);
      return pts;
    })();

    /* ── 3. INTERACTIVE FLOATING PARTICLES (react to mouse) ─────────────── */
    const floatCount = isMobile ? 60 : 150;
    const floatGroup = new THREE.Group();
    const floatPositions  = new Float32Array(floatCount * 3);
    const floatVelocities = new Float32Array(floatCount * 3); // vx,vy,vz
    const floatOriginal   = new Float32Array(floatCount * 3); // home positions
    for (let i = 0; i < floatCount; i++) {
      const x = (Math.random()-0.5)*600;
      const y = (Math.random()-0.5)*600;
      const z = (Math.random()-0.5)*200;
      floatPositions[i*3]=x;   floatPositions[i*3+1]=y;   floatPositions[i*3+2]=z;
      floatOriginal[i*3]=x;    floatOriginal[i*3+1]=y;    floatOriginal[i*3+2]=z;
      floatVelocities[i*3]=0;  floatVelocities[i*3+1]=0;  floatVelocities[i*3+2]=0;
    }
    const floatGeo = new THREE.BufferGeometry();
    floatGeo.setAttribute("position", new THREE.BufferAttribute(floatPositions,3));
    const floatMat = new THREE.PointsMaterial({
      size: isMobile ? 5 : 8, map: glowTex,
      color: new THREE.Color("#a855f7"),
      transparent: true, opacity: 0.55,
      blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const floatMesh = new THREE.Points(floatGeo, floatMat);
    floatGroup.add(floatMesh);
    scene.add(floatGroup);

    /* ── 4. SHOOTING STARS / METEORS ────────────────────────────────────── */
    type Meteor = { line: THREE.Line; speed: number; active: boolean; delay: number };
    const meteors: Meteor[] = [];
    for (let i = 0; i < 3; i++) {
      const geo  = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,0), new THREE.Vector3(70,-42,-28)]);
      const mat  = new THREE.LineBasicMaterial({ color: 0xd8b4fe, transparent: true, opacity: 0, blending: THREE.AdditiveBlending });
      const line = new THREE.Line(geo, mat);
      scene.add(line);
      meteors.push({ line, speed: 14+Math.random()*10, active: false, delay: Math.random()*400+100 });
    }
    function resetMeteor(m: Meteor) {
      m.line.position.set((Math.random()-0.2)*900, Math.random()*500+200, (Math.random()-0.5)*400);
      (m.line.material as THREE.LineBasicMaterial).opacity = 1.0;
      m.active = true;
    }

    /* ── 5. FLOATING GEOMETRIC ORBS (Spline-style) ───────────────────────── */
    if (!isMobile) {
      const orbData = [
        { r: 18, pos: [-380, 200, -200], color: 0x7c3aed, emissive: 0x4c1d95, opacity: 0.6 },
        { r: 12, pos: [ 420,-150, -150], color: 0x0891b2, emissive: 0x0e7490, opacity: 0.5 },
        { r:  8, pos: [-100, 300, -100], color: 0xc084fc, emissive: 0xa855f7, opacity: 0.4 },
        { r: 22, pos: [ 300, 280, -300], color: 0xf59e0b, emissive: 0xd97706, opacity: 0.35 },
      ];
      orbData.forEach(({ r, pos, color, emissive, opacity }) => {
        const mesh = new THREE.Mesh(
          new THREE.SphereGeometry(r, 32, 32),
          new THREE.MeshStandardMaterial({ color, emissive, emissiveIntensity: 0.5, roughness: 0.1, metalness: 0.9, transparent: true, opacity })
        );
        mesh.position.set(...(pos as [number,number,number]));
        scene.add(mesh);

        // Glow halo around orb
        const haloMesh = new THREE.Mesh(
          new THREE.SphereGeometry(r * 1.8, 16, 16),
          new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.08, side: THREE.BackSide })
        );
        haloMesh.position.copy(mesh.position);
        scene.add(haloMesh);
      });

      // Ambient point lights to illuminate scene
      const l1 = new THREE.PointLight(0x7c3aed, 60, 600);
      l1.position.set(-380, 200, -200);
      scene.add(l1);
      const l2 = new THREE.PointLight(0x06b6d4, 50, 500);
      l2.position.set(420, -150, -150);
      scene.add(l2);
    }

    /* ── Mouse & Scroll ─────────────────────────────────────────────────── */
    let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0, scrollY = 0;
    let mousePosX = 0, mousePosY = 0; // normalized -1..1

    window.addEventListener("mousemove", (e) => {
      mouseX = (e.clientX / window.innerWidth  - 0.5) * 50;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 50;
      mousePosX = (e.clientX / window.innerWidth  - 0.5) * 2;
      mousePosY = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });
    window.addEventListener("scroll", () => { scrollY = window.scrollY * 0.1; }, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      },
      { passive: true },
    );

    /* ── Render loop ────────────────────────────────────────────────────── */
    let prev = performance.now();
    function animate() {
      requestAnimationFrame(animate);
      const now   = performance.now();
      const delta = Math.min((now - prev) * 0.001, 0.05);
      prev = now;
      const t = now * 0.001;

      // Starfield gentle rotation
      scene.children[0]?.rotation && ((scene.children[0] as any).rotation.y += 0.00015);

      // Galaxy spin
      galaxyPoints.rotation.y += 0.00065;
      galaxyPoints.rotation.z += 0.00022;

      // Interactive floating particles — repel from mouse
      const fp = floatGeo.getAttribute("position") as THREE.BufferAttribute;
      for (let i = 0; i < floatCount; i++) {
        const ox = floatOriginal[i*3], oy = floatOriginal[i*3+1], oz = floatOriginal[i*3+2];
        // Convert mouse to 3D space (rough mapping)
        const mwx = mousePosX * 300, mwy = -mousePosY * 300;
        const dx = fp.getX(i) - mwx, dy = fp.getY(i) - mwy;
        const dist = Math.sqrt(dx*dx + dy*dy);
        const repelRadius = 120;

        if (dist < repelRadius) {
          const force = (repelRadius - dist) / repelRadius * 2.5;
          floatVelocities[i*3]   += (dx/dist) * force;
          floatVelocities[i*3+1] += (dy/dist) * force;
        }

        // Spring back to home
        floatVelocities[i*3]   += (ox - fp.getX(i)) * 0.012;
        floatVelocities[i*3+1] += (oy - fp.getY(i)) * 0.012;
        floatVelocities[i*3+2] += (oz - fp.getZ(i)) * 0.012;

        // Damping + gentle float
        floatVelocities[i*3]   *= 0.88;
        floatVelocities[i*3+1] *= 0.88;

        fp.setXYZ(i,
          fp.getX(i) + floatVelocities[i*3]   + Math.sin(t * 0.5 + i) * 0.3,
          fp.getY(i) + floatVelocities[i*3+1] + Math.cos(t * 0.4 + i) * 0.3,
          fp.getZ(i) + floatVelocities[i*3+2],
        );
      }
      fp.needsUpdate = true;

      // Pulsing opacity on floating particles
      floatMat.opacity = 0.45 + Math.sin(t * 1.2) * 0.12;

      // Meteor animation
      meteors.forEach((m) => {
        if (!m.active) {
          if (--m.delay <= 0) { resetMeteor(m); m.delay = 500 + Math.random()*700; }
        } else {
          m.line.position.x += m.speed;
          m.line.position.y -= m.speed * 0.6;
          const mat = m.line.material as THREE.LineBasicMaterial;
          mat.opacity -= delta * 0.85;
          if (mat.opacity <= 0.02) m.active = false;
        }
      });

      // Camera parallax
      targetX += (mouseX - targetX) * 0.025;
      targetY += (mouseY - targetY) * 0.025;
      camera.position.x = targetX;
      camera.position.y = -targetY - scrollY * 0.4;

      renderer.render(scene, camera);
    }

    animate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSpaceBackground);
  } else {
    initSpaceBackground();
  }
  document.addEventListener("astro:page-load", initSpaceBackground);
</script>
